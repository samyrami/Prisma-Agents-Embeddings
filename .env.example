# Copia este archivo a .env y rellena los valores reales.
# NUNCA commits credenciales reales al repo.

# -------- AWS S3 (bucket de conocimiento — necesita permisos de ESCRITURA) --------
S3_BUCKET=westfield-agent-knowledge
AWS_REGION=us-east-1
# S3_PREFIX=agents
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key

# -------- OpenAI (embeddings de documentos) --------
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1
