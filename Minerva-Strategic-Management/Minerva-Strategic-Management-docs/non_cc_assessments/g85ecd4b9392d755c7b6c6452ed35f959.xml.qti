        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El Perfil Estrat&#xE9;gico de la empresa:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d0afa16a-a59f-415b-9595-5e411a994676">
              <material>
                <mattext texttype="text/html">Debe incluir la situaci&#xF3;n de los competidores</mattext>
              </material>
            </response_label>
            <response_label ident="06aa46fd-d67d-4a86-a2fe-e337bd406e8c">
              <material>
                <mattext texttype="text/html">No debe incluir la situaci&#xF3;n de los competidores</mattext>
              </material>
            </response_label>
            <response_label ident="6f496aea-6190-4c59-82b1-85c06eb2b7af">
              <material>
                <mattext texttype="text/html">Es irrelevante si se incluye o no la situaci&#xF3;n de los competidores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">d0afa16a-a59f-415b-9595-5e411a994676</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Precisamente la inclusi&#xF3;n de la situaci&#xF3;n de los competidores es fundamental para comparar la situaci&#xF3;n de la compa&#xF1;&#xED;a en cada variable con respecto a la competencia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
