            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El entorno espec&#xED;fico de la empresa se centra en el an&#xE1;lisis del contexto&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="75c7c54a-6605-49e7-91a0-352bddf7663d">
              <material>
                <mattext texttype="text/html">pol&#xED;tico &#x2013; legal</mattext>
              </material>
            </response_label>
            <response_label ident="28360576-6e72-4a54-8381-010b3a746a28">
              <material>
                <mattext texttype="text/html">sociocultural</mattext>
              </material>
            </response_label>
            <response_label ident="5800474a-9289-4af0-8241-1d97bff6e160">
              <material>
                <mattext texttype="text/html">demogr&#xE1;fico</mattext>
              </material>
            </response_label>
            <response_label ident="ac940dc5-42c2-4cbc-bd49-96a6a84d0cca">
              <material>
                <mattext texttype="text/html">ninguno de los anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">ac940dc5-42c2-4cbc-bd49-96a6a84d0cca</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El entorno espec&#xED;fico se refiere a la parte del entorno m&#xE1;s cercana a la actividad habitual de la empresa, es decir al sector de actividad econ&#xF3;mica al que pertenece la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="e446aae970d58d7c4fe72bfcad8458f7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7a6aaa3b-b304-4012-a26b-15dbe2806ccb,edb3cad7-9761-4b9b-bb18-5fa71720ea87,6ae36f5c-e22b-41a1-8517-a2fc4943a4fd,83a09b64-9522-4316-926e-14bd36e72445</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>1e75f35449f5e88bffdf6d8c1ad84470</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El an&#xE1;lisis estrat&#xE9;gico se ocupa del diagn&#xF3;stico&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7a6aaa3b-b304-4012-a26b-15dbe2806ccb">
              <material>
                <mattext texttype="text/html">de los factores externos a la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="edb3cad7-9761-4b9b-bb18-5fa71720ea87">
              <material>
                <mattext texttype="text/html">de los factores internos a la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="6ae36f5c-e22b-41a1-8517-a2fc4943a4fd">
              <material>
                <mattext texttype="text/html">de los factores internos y externos.</mattext>
              </material>
            </response_label>
            <response_label ident="83a09b64-9522-4316-926e-14bd36e72445">
              <material>
                <mattext texttype="text/html">de las tendencias econ&#xF3;micas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6ae36f5c-e22b-41a1-8517-a2fc4943a4fd</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El an&#xE1;lisis estrat&#xE9;gico incluye el diagn&#xF3;stico de las oportunidades y amenazas (factores externos) ante las que puede enfrentarse la compa&#xF1;&#xED;a, y los puntos fuertes y d&#xE9;biles (factores internos) con que cuenta la misma.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
  </objectbank>
