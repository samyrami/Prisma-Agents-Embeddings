          <render_choice>
            <response_label ident="27619b63-051f-472b-8619-0ee6d4540ab0">
              <material>
                <mattext texttype="text/html">Puede utilizar diferentes &#xE1;reas funcionales seg&#xFA;n la empresa</mattext>
