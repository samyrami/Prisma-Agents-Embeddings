    <item ident="690a5bafa5ee684b76ec7fcf73fce3e3" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1ad9bc19-f329-486c-8de9-7912b9653d95,db17b279-90c8-472f-a128-adbd1dcb84b5,4d29fdd3-2bff-45ae-a718-0eb57bacf347,a64889ae-03a1-4024-9090-b4a5323b1fe2</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d564c6f3e7a42dd4f8c191a8b45ce5e3</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En el an&#xE1;lisis DAFO.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1ad9bc19-f329-486c-8de9-7912b9653d95">
              <material>
                <mattext texttype="text/html">Analizamos las amenazas y oportunidades</mattext>
              </material>
            </response_label>
            <response_label ident="db17b279-90c8-472f-a128-adbd1dcb84b5">
              <material>
                <mattext texttype="text/html">Analizamos las fortalezas y debilidades</mattext>
              </material>
            </response_label>
            <response_label ident="4d29fdd3-2bff-45ae-a718-0eb57bacf347">
              <material>
                <mattext texttype="text/html">Podremos establecer c&#xF3;mo organizar los recursos para utilizarlos de la forma m&#xE1;s eficiente</mattext>
              </material>
            </response_label>
            <response_label ident="a64889ae-03a1-4024-9090-b4a5323b1fe2">
              <material>
                <mattext texttype="text/html">Todas las opciones son correctas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">a64889ae-03a1-4024-9090-b4a5323b1fe2</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Todas las opciones son correctas: El An&#xE1;lisis DAFO tiene en cuenta las debilidades, amenazas, fortalezas y oportunidades. Por otro lado, organizar los recursos para utilizarlos de la forma m&#xE1;s eficiente esa es una de las preguntas que se debe tratar de contestar con el an&#xE1;lisis DAFO.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
