      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La optimizaci&#xF3;n de los procesos o actividades de la cadena de valor:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="721d1e1a-6cee-4e74-a54c-a2cf858b7a50">
              <material>
                <mattext texttype="text/html">Se consigue por la coordinaci&#xF3;n de las actividades</mattext>
              </material>
            </response_label>
            <response_label ident="1cca0e1c-05e1-4bba-9956-2740b487e24e">
              <material>
                <mattext texttype="text/html">Busca reducir los costes de otras actividades mejorando una de las actividades</mattext>
              </material>
            </response_label>
            <response_label ident="afe2525d-23bd-452a-a7f5-9afef9c3e400">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1cca0e1c-05e1-4bba-9956-2740b487e24e</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La optimizaci&#xF3;n de los procesos o actividades buscan reducir los costes de otras actividades mejorando una de las actividades.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="aa96fb7cf1ffda934420f2391166e370" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
