    <item ident="3024e38cc0b622fd4c668fe9550d20e6" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>36a7da78-2433-4f99-82ce-e85fb3f15dd6,ffac39bb-6adc-4a66-9596-86b7eb2593b7,fd75d1e8-289c-4282-ad91-9550a3581c70,3c28dd74-2612-4192-914d-4674f8cfa3e8</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>318fc733b8921657e8818592b73d6807</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La probabilidad de reacci&#xF3;n de los competidores existentes ante la entrada de una nueva empresa ser&#xE1; mayor si&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36a7da78-2433-4f99-82ce-e85fb3f15dd6">
              <material>
                <mattext texttype="text/html">existe tradici&#xF3;n de este tipo de reacciones</mattext>
              </material>
            </response_label>
            <response_label ident="ffac39bb-6adc-4a66-9596-86b7eb2593b7">
              <material>
                <mattext texttype="text/html">hay poca movilidad de los activos</mattext>
              </material>
            </response_label>
            <response_label ident="fd75d1e8-289c-4282-ad91-9550a3581c70">
              <material>
                <mattext texttype="text/html">las compa&#xF1;&#xED;as existentes tienen recursos suficientes para defenderse</mattext>
              </material>
            </response_label>
            <response_label ident="3c28dd74-2612-4192-914d-4674f8cfa3e8">
              <material>
                <mattext texttype="text/html">todas las anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3c28dd74-2612-4192-914d-4674f8cfa3e8</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&amp;nbsp;Entre las condiciones que se&#xF1;alan una alta probabilidad de reacci&#xF3;n por parte de los competidores existentes ante la entrada de una nueva empresa, destacan las tres citadas, junto con la existencia de un sector con un ritmo de crecimiento lento.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="f88c7aa446cfda5b672ebf9964389699" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>75c7c54a-6605-49e7-91a0-352bddf7663d,28360576-6e72-4a54-8381-010b3a746a28,5800474a-9289-4af0-8241-1d97bff6e160,ac940dc5-42c2-4cbc-bd49-96a6a84d0cca</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
