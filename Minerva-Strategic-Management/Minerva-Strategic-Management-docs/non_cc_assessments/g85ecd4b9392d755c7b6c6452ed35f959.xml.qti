            <varequal respident="response1">27619b63-051f-472b-8619-0ee6d4540ab0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las &#xE1;reas funcionales que consideremos depender&#xE1;n de cada empresa, ya que cada uno de los aspectos que analicemos podr&#xE1; tener una importancia diferente seg&#xFA;n el tipo de empresa analizado o el sector donde est&#xE1; compita, e incluso en la forma de competencia dentro del sector.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="d37bb4af8c6094836bbec59b732478b2" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
