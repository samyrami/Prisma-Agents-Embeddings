      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El estado en el que se encuentran los bienes de equipo (utilizados en el proceso de producci&#xF3;n)&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="02594de1-8181-45ce-9419-fcd6fa6278d0">
              <material>
                <mattext texttype="text/html">Debe ser una de las variables a incluir en el an&#xE1;lisis funcional</mattext>
              </material>
            </response_label>
            <response_label ident="9c430261-d561-44c0-a35f-125bc858c57a">
              <material>
                <mattext texttype="text/html">Influye en el volumen de producci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="8e344982-df42-4e11-ac64-e1fe12046725">
              <material>
                <mattext texttype="text/html">Impacta en el servicio al cliente por cumplimiento de los pedidos&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="178347d4-3e2e-4e86-b005-21fab2c520e5">
              <material>
                <mattext texttype="text/html">Todas las opciones son correctas</mattext>
