            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El an&#xE1;lisis interno:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="e23d1222-0098-4666-8f9c-4743e514b5fe">
              <material>
                <mattext texttype="text/html">Se interesa por determinar cu&#xE1;les son los puntos fuertes y d&#xE9;biles de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="486cf2e0-8417-42fa-bb3a-aa026cf53940">
              <material>
                <mattext texttype="text/html">Se interesa por los aspectos del entorno que pueden influir en la actividad de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="b86bea9b-a2f3-43e9-ab01-3b20d2f2f95b">
              <material>
                <mattext texttype="text/html">Muestra c&#xF3;mo caracter&#xED;sticas similares del entorno pueden tener repercusiones diferentes en cada sector e, incluso, entre las empresas de una misma industria</mattext>
              </material>
            </response_label>
            <response_label ident="bb8c36ae-276a-4777-abb5-b8d68771f527">
              <material>
                <mattext texttype="text/html">Todas las opciones son correctas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">e23d1222-0098-4666-8f9c-4743e514b5fe</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El an&#xE1;lisis interno se interesa por determinar cu&#xE1;les son los puntos fuertes y d&#xE9;biles de la empresa. El an&#xE1;lisis del entorno es el que se interesa por los aspectos del entorno que pueden influir en la actividad de la empresa, y forma parte del an&#xE1;lisis externo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
