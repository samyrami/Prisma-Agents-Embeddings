          <mattext texttype="text/html">&lt;div&gt;El entorno espec&#xED;fico est&#xE1; relacionado con&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="a1f5b5f4-1f55-4dda-ae5b-6cd731c31aa5">
              <material>
                <mattext texttype="text/html">Los factores externos a la empresa directamente ligados al sector o industria donde compite</mattext>
              </material>
            </response_label>
            <response_label ident="0703d7be-a3a7-43bb-afa6-900ab51b88dd">
              <material>
                <mattext texttype="text/html">Los factores internos a la empresa directamente ligados al sector o industria donde compite&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="46438c99-f411-42fd-bb91-3c9ce56cd9e3">
              <material>
                <mattext texttype="text/html">Los factores internos a la empresa directamente ligados a todo el entorno econ&#xF3;mico, a todos los mercados y sectores</mattext>
              </material>
            </response_label>
            <response_label ident="f230884e-20e8-456c-902d-4b6efb6d3d6b">
              <material>
                <mattext texttype="text/html">Los factores externos a la empresa directamente ligados a todo el entorno econ&#xF3;mico, a todos los mercados y sectores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
