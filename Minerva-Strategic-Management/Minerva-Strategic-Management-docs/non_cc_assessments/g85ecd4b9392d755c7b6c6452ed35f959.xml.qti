            <response_label ident="84cfbca0-876d-4968-a709-370d91189447">
              <material>
                <mattext texttype="text/html">No est&#xE1; influido en la elecci&#xF3;n de las &#xE1;reas funcionales que utiliza por las formas de competencia en el sector</mattext>
              </material>
            </response_label>
            <response_label ident="2eab8d5c-396c-460c-a5b5-573b6404117d">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
