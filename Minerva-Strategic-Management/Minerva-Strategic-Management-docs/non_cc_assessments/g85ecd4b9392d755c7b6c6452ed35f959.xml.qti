            <varequal respident="response1">178347d4-3e2e-4e86-b005-21fab2c520e5</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Todas las opciones son correctas: Esta es una de las variables m&#xE1;s importantes para las empresas productoras, ya que el volumen de producci&#xF3;n depender&#xE1; de ella. Tambi&#xE9;n impacta en el servicio al cliente por cumplimiento de los pedidos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
