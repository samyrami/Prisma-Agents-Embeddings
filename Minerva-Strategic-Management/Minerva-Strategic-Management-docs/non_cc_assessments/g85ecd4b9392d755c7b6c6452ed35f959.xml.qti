        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Las fuentes de las ventajas competitivas:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="11f5acc3-9dea-4eaf-a8da-9ab71aa2a680">
              <material>
                <mattext texttype="text/html">Son los aspectos o partes de la empresa que m&#xE1;s contribuyen a la generaci&#xF3;n de valor&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="a7a6fc00-000f-47d3-8fc6-21b09be600dd">
              <material>
                <mattext texttype="text/html">Son los aspectos o partes de la empresa que menos contribuyen a la generaci&#xF3;n de valor</mattext>
              </material>
            </response_label>
            <response_label ident="da6001fc-7112-4be9-ae95-08f815a1fc04">
              <material>
                <mattext texttype="text/html">No contribuyen necesariamente a la generaci&#xF3;n de valor</mattext>
              </material>
            </response_label>
            <response_label ident="47fe7f94-0799-4f27-994a-dcf331fb8634">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">11f5acc3-9dea-4eaf-a8da-9ab71aa2a680</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las ventajas competitivas son precisamente los aspectos o partes de la empresa que m&#xE1;s contribuyen a la generaci&#xF3;n de valor.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="66aa6f2b28b63a048e62ca19598ebbe3" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>fcb6dc09-d429-4d88-b946-47e410487f18,949f28a9-e0d5-4c72-af70-893d1b3fbaf9,7dd15ac4-9e78-48af-9112-1d5b9246e93b,f4c830f0-9c23-48b9-9918-958d95c6fd2c</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d32f2c04c12215299cb7241321e95146</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La cadena de valor&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="fcb6dc09-d429-4d88-b946-47e410487f18">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para vender un producto, pero no se aplica para las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="949f28a9-e0d5-4c72-af70-893d1b3fbaf9">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para fabricar un producto, pero no se aplica para las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="7dd15ac4-9e78-48af-9112-1d5b9246e93b">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para vender un producto, y puede aplicarse a las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="f4c830f0-9c23-48b9-9918-958d95c6fd2c">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para fabricar un producto, y puede aplicarse a las empresas de servicio</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7dd15ac4-9e78-48af-9112-1d5b9246e93b</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La cadena de valor desagrega todas las actividades b&#xE1;sicas necesarias para la venta de un producto o un servicio. Es decir, no se queda &#xFA;nicamente en la fabricaci&#xF3;n, y es de aplicaci&#xF3;n tambi&#xE9;n para las empresas de servicio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="5e4953d194b01fb7e9de6c62668aac2e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
