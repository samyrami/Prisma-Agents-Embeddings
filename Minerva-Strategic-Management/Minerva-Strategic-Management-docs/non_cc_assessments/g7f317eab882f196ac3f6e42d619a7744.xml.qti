      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El modelo estrat&#xE9;gico es una representaci&#xF3;n del conjunto de actividades y activos y c&#xF3;mo se relacionan de una manera distinta al resto de los competidores para entregar la propuesta de valor de una forma diferencial y dif&#xED;cilmente copiable. &amp;nbsp;</mattext>
          </material>
        </flow_mat>
