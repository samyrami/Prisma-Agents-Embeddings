    <item ident="fbac17e1f54d5ef742918adc1bfdbb1d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>34abce82-9e6d-4215-a034-5af070f4efea,9a37ade4-6801-401d-bcac-b5c3cd949563,31b77309-0841-4c7c-9eb8-d8d44f4985e4,09b5f39a-b9f5-4306-9cad-3774214d42fc</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>071a9c243da80e18c991563de1cf40cb</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La visi&#xF3;n estrat&#xE9;gica de la empresa.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="34abce82-9e6d-4215-a034-5af070f4efea">
              <material>
                <mattext texttype="text/html">Deben conocerla todos los integrantes de la empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="9a37ade4-6801-401d-bcac-b5c3cd949563">
              <material>
                <mattext texttype="text/html">Basta con que la conozcan los directivos intermedios.</mattext>
              </material>
            </response_label>
            <response_label ident="31b77309-0841-4c7c-9eb8-d8d44f4985e4">
              <material>
                <mattext texttype="text/html">Basta con que la conozcan los directivos de primer nivel.</mattext>
              </material>
            </response_label>
            <response_label ident="09b5f39a-b9f5-4306-9cad-3774214d42fc">
              <material>
                <mattext texttype="text/html">Es un elemento b&#xE1;sico de la estrategia, y por tanto debe conocerla &#xFA;nicamente el CEO de la compa&#xF1;&#xED;a.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">34abce82-9e6d-4215-a034-5af070f4efea</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La visi&#xF3;n estrat&#xE9;gica debe ser conocida por todos los integrantes de la empresa, ya que las personas que la componen deben conocer hacia d&#xF3;nde se dirige, facilitando su compromiso con la compa&#xF1;&#xED;a y reforzando el orgullo de sentirse parte de ella.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="337856f1d53abb566a198c1b69883cab" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>f95c3af5-35db-4c6c-8ec2-dd1deb606712,21913334-c3a4-433c-b9d5-90ee93326f21,df281eed-7bfb-4692-beff-5a169f85d83c,539ec89c-9b2f-4cc1-b078-344aea6ac1a4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>86699b5193b5da5f1e94c80ff41cbb15</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En la creaci&#xF3;n de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="f95c3af5-35db-4c6c-8ec2-dd1deb606712">
              <material>
                <mattext texttype="text/html">Debe opinar y participar toda la compa&#xF1;&#xED;a.</mattext>
              </material>
            </response_label>
            <response_label ident="21913334-c3a4-433c-b9d5-90ee93326f21">
              <material>
                <mattext texttype="text/html">S&#xF3;lo opinan y se involucran los directivos.</mattext>
              </material>
            </response_label>
            <response_label ident="df281eed-7bfb-4692-beff-5a169f85d83c">
              <material>
                <mattext texttype="text/html">Los directivos definen la estrategia, y la estrategia es ajena al resto de la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="539ec89c-9b2f-4cc1-b078-344aea6ac1a4">
              <material>
                <mattext texttype="text/html">Los directivos definen la estrategia, y deben involucrar al resto de la compa&#xF1;&#xED;a en su ejecuci&#xF3;n.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">539ec89c-9b2f-4cc1-b078-344aea6ac1a4</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La creaci&#xF3;n de una estrategia, junto con su ejecuci&#xF3;n son funciones directivas esenciales. Corresponde por tanto a los directivos definir la estrategia e involucrar a todos los integrantes de la empresa para que su ejecuci&#xF3;n se ajuste a la definici&#xF3;n realizada.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ee8e6b78b2317616d12574494da0c61c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
