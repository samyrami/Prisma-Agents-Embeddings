                <mattext texttype="text/plain">Eficiencia operativa, mejora continua, expansión de mercado, innovación de productos</mattext>
              </material>
            </response_label>
            <response_label ident="12065">
              <material>
                <mattext texttype="text/plain">Liderazgo en costes, diferenciación, especialización, innovación tecnológica</mattext>
              </material>
            </response_label>
            <response_label ident="83691">
              <material>
                <mattext texttype="text/plain">Posicionamiento basado en necesidades, posicionamiento basado en producto, posicionamiento basado en acceso, posicionamiento basado en experiencia</mattext>
              </material>
            </response_label>
            <response_label ident="11737">
              <material>
                <mattext texttype="text/plain">Segmentación de mercado, penetración de mercado, diversificación de productos, marketing relacional</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
