      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Posicionamiento basado en necesidades, posicionamiento basado en producto, posicionamiento basado en acceso, posicionamiento basado en experiencia. El Prof. Porter propuso las tres primeras y recientemente a aparecido una nueva basada en experiencias</mattext>
