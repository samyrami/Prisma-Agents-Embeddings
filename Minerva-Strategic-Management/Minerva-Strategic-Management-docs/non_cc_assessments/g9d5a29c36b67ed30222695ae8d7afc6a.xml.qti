    <item ident="ge024c18ba915674bc263015e443f4398" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>57800,942,72609,92479</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuáles son las razones estratégicas para que ocurra un escenario de hypercompetencia?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="57800">
              <material>
                <mattext texttype="text/plain">Mejoras en la eficiencia operativa, expansión internacional, innovación disruptiva, aumento de la demanda del mercado</mattext>
              </material>
            </response_label>
            <response_label ident="942">
              <material>
                <mattext texttype="text/plain">Imitación rápida de funcionalidades, competencia basada en precio, ofertas indiferenciadas, guerra de marketing</mattext>
              </material>
            </response_label>
            <response_label ident="72609">
              <material>
                <mattext texttype="text/plain">Diversificación de productos, desarrollo de nuevas tecnologías, mejora en la calidad del producto, alianzas estratégicas</mattext>
              </material>
            </response_label>
            <response_label ident="92479">
              <material>
                <mattext texttype="text/plain">Monopolio de mercado, regulación gubernamental, alta lealtad del cliente, barreras de entrada elevadas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">942</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Imitación rápida de funcionalidades, competencia basada en precio, ofertas indiferenciadas, guerra de marketing. Los escenarios de hypercompetencia ocurren cuando las ofertas de los distintos competidores son indiferenciadas de cara al consumidor lo que genera que a los consumidores “les de lo mismo” elegir un proveedor u otro, en estos escenarios se eligen las alternativas más baratas lo que desencadenan guerras de precio, o se dota a los productos de nuevas funcionalidades (que aumentan los costes) y que son rápidamente copiadas por los competidores. En general, en un mercado donde los competidores sólo compiten en eficiencia operativa y no en estrategia (buscar un posicionamiento diferencial, valioso y sostenible) inevitablemente acaban en un entorno hypercompetitivo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
  </objectbank>
