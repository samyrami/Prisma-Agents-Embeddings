        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria madura:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d66fdcad-3e16-4969-b581-628dd0d173f2">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional AUMENTA el atractivo de la industria porque AUMENTA los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="5b0eb100-3778-4a11-afea-9423911fe14d">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional AUMENTA el atractivo de la industria porque DISMINUYE los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="d8b58d38-0d8e-4513-8370-e4b8eacec8dd">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional DISMINUYE el atractivo de la industria porque AUMENTA los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="48d454c3-3e14-4b59-852d-6d66af858257">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional DISMINUYE el atractivo de la industria porque DISMINUYE los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="27285de8-df76-48ff-9d56-77ea2d385ad9">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">48d454c3-3e14-4b59-852d-6d66af858257</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Uno de los factores que inciden en el deterioro del atractivo de una industria es, precisamente, el aumento de la competencia internacional, ya que, a menudo, viene acompa&#xF1;ada con la estandarizaci&#xF3;n del producto y la disminuci&#xF3;n de m&#xE1;rgenes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
