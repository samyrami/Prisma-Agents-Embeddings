    <item ident="922e1a48f1a50ba46972f638ee8b18e3" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>064fe6a9-e5e6-4595-a712-9dfe8c10c5c1,88e03b72-b51e-46a4-9d52-64441deeb1bf,9bd12201-c5f2-4c80-95bc-0d56e972c09e</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>02f38b8ea4b06805a0b0695aa12189b8</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;ndo favorece la estrategia de enfoque la existencia de un nicho de mercado?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="064fe6a9-e5e6-4595-a712-9dfe8c10c5c1">
              <material>
                <mattext texttype="text/html">Cuando es manejable (nicho de mercado peque&#xF1;o)</mattext>
              </material>
            </response_label>
            <response_label ident="88e03b72-b51e-46a4-9d52-64441deeb1bf">
              <material>
                <mattext texttype="text/html">Cuando es suficientemente grande</mattext>
              </material>
            </response_label>
            <response_label ident="9bd12201-c5f2-4c80-95bc-0d56e972c09e">
              <material>
                <mattext texttype="text/html">Si hay un nicho identificable, siempre es interesante una estrategia de enfoque. El tama&#xF1;o del nicho no favorece o dificulta la posibilidad de desarrollar una estrategia de enfoque</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">88e03b72-b51e-46a4-9d52-64441deeb1bf</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El nicho de mercado debe ser lo suficientemente grande como para que sea rentable. Por tanto, el tama&#xF1;o del nicho influye, y ser&#xE1; m&#xE1;s f&#xE1;cil desarrollar la estrategia de enfoque si el nicho es grande.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="3bdb5944ec73fcd201fcf4f24898117f" title="Question">
      <itemmetadata>
