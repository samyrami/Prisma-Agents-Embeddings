          <render_choice>
            <response_label ident="fa0bbd34-3ee1-486f-bdc8-f19d4573f9a4">
              <material>
                <mattext texttype="text/html">Es infrecuente la cooperaci&#xF3;n entre competidores pues puede retrasar la consolidaci&#xF3;n de la industria</mattext>
              </material>
            </response_label>
            <response_label ident="6cbcf32b-775c-4db4-901f-582b191f088f">
              <material>
                <mattext texttype="text/html">Es habitual la cooperaci&#xF3;n entre competidores para evitar una consolidaci&#xF3;n r&#xE1;pida de la industria</mattext>
              </material>
            </response_label>
            <response_label ident="17d472f2-0411-4121-9966-0dcc96cff06c">
              <material>
                <mattext texttype="text/html">Es habitual la cooperaci&#xF3;n entre competidores pues puede acelerar la consolidaci&#xF3;n r&#xE1;pida de la industria</mattext>
              </material>
            </response_label>
            <response_label ident="13078f79-1db3-478e-b4c2-0b3b5d4f8c6e">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
