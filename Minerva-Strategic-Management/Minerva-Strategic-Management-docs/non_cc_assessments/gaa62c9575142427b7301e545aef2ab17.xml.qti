    <item ident="29ddab7e6bcbd2df03374702d3cf8878" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>73fe59f0-25ab-4e67-8358-a9700f7aed97,86a3db00-2cf2-477c-ae65-b7434aa006bd,fc110d42-853a-4826-a4d0-54631ca142e4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>90020c3f452df6ba6380cd85eb1f57ce</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El posicionamiento estrat&#xE9;gico:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73fe59f0-25ab-4e67-8358-a9700f7aed97">
              <material>
                <mattext texttype="text/html">Debe de ser el mismo en todos los pa&#xED;ses donde se comercializa el producto, por coherencia de la estrategia, y adem&#xE1;s debe de ser igual al del mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
            <response_label ident="86a3db00-2cf2-477c-ae65-b7434aa006bd">
              <material>
                <mattext texttype="text/html">Debe de ser el mismo en todos los pa&#xED;ses donde se comercializa el producto, por coherencia de la estrategia, pero puede diferir del mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
            <response_label ident="fc110d42-853a-4826-a4d0-54631ca142e4">
              <material>
                <mattext texttype="text/html">No necesariamente debe de ser el mismo en los diferentes pa&#xED;ses donde se comercializa el producto, ni tiene por qu&#xE9; coincidir con el mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">fc110d42-853a-4826-a4d0-54631ca142e4</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El posicionamiento estrat&#xE9;gico debe desarrollarse para cada uno de los pa&#xED;ses, y dentro de ellos por cada uno de los segmentos a los que se dirigir&#xE1; el producto. Por tanto, no tiene por qu&#xE9; ser el mismo en todos los pa&#xED;ses, ni coincidir con el del mercado dom&#xE9;stico.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="575887354c03bb656fac714cce8b6df4" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>499a2063-8726-4a16-9129-51904465cfe8,956b398d-8d98-4519-9713-ae2a1d924431,4c87f516-2f8c-4273-aa95-1f3e42a88bc4,d3c00aba-0f9f-43fb-9682-45848724e18e</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>3ecb5e220fdb8e85478feb3982de5fdf</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La estrategia de internacionalizaci&#xF3;n:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="499a2063-8726-4a16-9129-51904465cfe8">
              <material>
                <mattext texttype="text/html">Requerir&#xE1; contar con un producto de calidad &#xFA;nicamente cuando el mercado de ese pa&#xED;s est&#xE1; demandando un producto de calidad</mattext>
              </material>
            </response_label>
            <response_label ident="956b398d-8d98-4519-9713-ae2a1d924431">
              <material>
                <mattext texttype="text/html">Es independiente con el hecho de contar con un producto de calidad, tiene m&#xE1;s que ver con variables como el conocimiento del mercado o el acceso a canales de distribuci&#xF3;n donde exista demanda del producto</mattext>
              </material>
            </response_label>
            <response_label ident="4c87f516-2f8c-4273-aa95-1f3e42a88bc4">
              <material>
                <mattext texttype="text/html">Tiene como primer requisito contar con un producto de calidad</mattext>
              </material>
            </response_label>
            <response_label ident="d3c00aba-0f9f-43fb-9682-45848724e18e">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4c87f516-2f8c-4273-aa95-1f3e42a88bc4</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El primer requisito para tener &#xE9;xito en una estrategia de internacionalizaci&#xF3;n es contar con un producto de calidad, y a partir de ah&#xED; decidir el binomio producto-mercado m&#xE1;s adecuado. Intentar esta estrategia sin un producto de calidad, aunque pensemos que el mercado no lo va a demandar, ser&#xED;a un grave error.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="b26f697c76285c46816744452afb5331" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>f6acb080-d490-4ee5-a070-f0e8f0c4c1db,df292012-fdde-48e5-846c-f3d0c5bcb029,100d8ff2-59a8-4d68-9f25-6951cd1d83ca,f727d9b9-ab43-48f8-a16c-3958d6b06893</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>c34e4a8e946f4840bebc034554b6b3f2</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria en declive:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="f6acb080-d490-4ee5-a070-f0e8f0c4c1db">
              <material>
                <mattext texttype="text/html">Cuanto MAYORES sean las barreras de SALIDA, m&#xE1;s DIF&#xCD;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="df292012-fdde-48e5-846c-f3d0c5bcb029">
              <material>
                <mattext texttype="text/html">Cuanto MENORES sean las barreras de SALIDA, m&#xE1;s DIF&#xCD;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="100d8ff2-59a8-4d68-9f25-6951cd1d83ca">
              <material>
                <mattext texttype="text/html">Cuanto MAYORES sean las barreras de ENTRADA, m&#xE1;s F&#xC1;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="f727d9b9-ab43-48f8-a16c-3958d6b06893">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">f6acb080-d490-4ee5-a070-f0e8f0c4c1db</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las grandes inversiones realizadas y la dificultad de recuperar las mismas, har&#xE1; que muchas empresas decidan continuar produciendo, a pesar de la reducci&#xF3;n de la demanda, generando un incremento muy importante de la competencia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="a208f81255e8ccfe77cb8f40099399d5" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>937a67f8-f628-49ca-ab07-054db36bb4a6,763c334d-83f5-4673-a992-a31b9562a25f,4591e7a7-ad5f-4ecc-92af-0002f522c579,ddd81169-b78c-44c9-b8fe-633cd7bf5527</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>7286ae17397d7e7a472366f6644d6298</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando el producto est&#xE1; estandarizado:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="937a67f8-f628-49ca-ab07-054db36bb4a6">
              <material>
                <mattext texttype="text/html">No es posible desarrollar una estrategia de diferenciaci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="763c334d-83f5-4673-a992-a31b9562a25f">
              <material>
                <mattext texttype="text/html">Resulta m&#xE1;s f&#xE1;cil desarrollar una estrategia de diferenciaci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="4591e7a7-ad5f-4ecc-92af-0002f522c579">
              <material>
                <mattext texttype="text/html">Es m&#xE1;s complicado desarrollar una estrategia de diferenciaci&#xF3;n, pero siempre es posible generarla</mattext>
              </material>
            </response_label>
            <response_label ident="ddd81169-b78c-44c9-b8fe-633cd7bf5527">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4591e7a7-ad5f-4ecc-92af-0002f522c579</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&amp;nbsp;A pesar de que el producto est&#xE9; muy estandarizado, siempre es posible introducir determinadas mejoras que faciliten el desarrollo de una estrategia de diferenciaci&#xF3;n. Esas mejoras pueden darse en el servicio, en la calidad o en la distribuci&#xF3;n.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="587ff878a27a264623652e332c28c1c7" title="Question">
