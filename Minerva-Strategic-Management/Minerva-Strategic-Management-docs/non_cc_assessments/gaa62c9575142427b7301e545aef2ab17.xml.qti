            <fieldentry>5fe47d55-72fc-4f83-90e3-0bb46775dd5e,7071c45f-9e3f-4c49-895f-e7228a624bb1,1c132ace-99d0-41f1-965d-5d4aa3aaf008,3c35d8cb-dc69-4fe1-b859-25bf8a6b54fd</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>e2b8723e4bff78d35ed313c82a466c4c</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria emergente:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5fe47d55-72fc-4f83-90e3-0bb46775dd5e">
              <material>
                <mattext texttype="text/html">Las empresas poseen una sola opci&#xF3;n estrat&#xE9;gica</mattext>
              </material>
            </response_label>
            <response_label ident="7071c45f-9e3f-4c49-895f-e7228a624bb1">
              <material>
                <mattext texttype="text/html">Las empresas poseen siempre un muy reducido n&#xFA;mero de opciones estrat&#xE9;gicas, aunque no necesariamente una &#xFA;nica opci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="1c132ace-99d0-41f1-965d-5d4aa3aaf008">
              <material>
                <mattext texttype="text/html">Las empresas suelen disponer de un n&#xFA;mero elevado de opciones estrat&#xE9;gicas</mattext>
              </material>
            </response_label>
            <response_label ident="3c35d8cb-dc69-4fe1-b859-25bf8a6b54fd">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">1c132ace-99d0-41f1-965d-5d4aa3aaf008</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En una industria emergente, la incertidumbre estrat&#xE9;gica hace que las empresas disponen, generalmente, de un n&#xFA;mero elevado de opciones estrat&#xE9;gicas, que se revelar&#xE1;n adecuadas o no a medida que la industria se consolide.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="4c111fa39c5caad5e2d1ea4da0a5d77e" title="Question">
      <itemmetadata>
