      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Una estrategia para competir en mercados internacionales&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="f36fa069-750d-47ea-8c2f-f9e63f0ac8c6">
              <material>
                <mattext texttype="text/html">Puede ser reversible con facilidad, porque suele requerir poca inversi&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="bffed64b-b7c2-4ca3-947b-bd8dfadcc8d5">
              <material>
                <mattext texttype="text/html">Puede ser reversible con facilidad, porque normalmente requiere invertir muchos recursos</mattext>
              </material>
            </response_label>
            <response_label ident="f2780416-c06f-47f1-b452-49e7b55f2b5b">
              <material>
                <mattext texttype="text/html">No suele ser reversible con facilidad, porque suele requerir poca inversi&#xF3;n y habr&#xE1; surgido mucha competencia</mattext>
              </material>
            </response_label>
            <response_label ident="4f296e5c-c1b2-49bc-b08e-604860e14663">
              <material>
                <mattext texttype="text/html">No suele ser reversible con facilidad, porque normalmente requiere invertir muchos recursos</mattext>
              </material>
            </response_label>
            <response_label ident="980839ec-9a6b-44fd-94b4-803565ba673c">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4f296e5c-c1b2-49bc-b08e-604860e14663</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Cuando se adoptan decisiones para implantar una estrategia encaminada a competir en mercados internacionales debe considerarse que es muy dif&#xED;cil la vuelta atr&#xE1;s, ya que habr&#xE1; sido necesario invertir grandes recursos en todo el proceso.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="810e3a720410ff5fc8dcf670aa1d2cdb" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
