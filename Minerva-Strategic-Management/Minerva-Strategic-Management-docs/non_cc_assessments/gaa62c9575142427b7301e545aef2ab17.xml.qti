            <response_label ident="313c2785-8d53-49e9-98bf-c2485c201211">
              <material>
                <mattext texttype="text/html">Facilitan una disminuci&#xF3;n de las existencias</mattext>
              </material>
            </response_label>
            <response_label ident="54500d73-2d68-4302-adf4-e6718487c389">
              <material>
                <mattext texttype="text/html">Nunca est&#xE1;n relacionadas con los niveles de existencias de la empresa</mattext>
