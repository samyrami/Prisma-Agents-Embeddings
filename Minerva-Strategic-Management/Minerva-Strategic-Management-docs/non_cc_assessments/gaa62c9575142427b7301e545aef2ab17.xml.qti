          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">04868ec9-6b9c-417c-ab20-c79dafc9ff0d</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La diferenciaci&#xF3;n de productos puede ir m&#xE1;s all&#xE1; del propio producto y estar basada en caracter&#xED;sticas propias de la empresa, como los planes de responsabilidad social corporativa y conseguir en base a ellos desarrollar una estrategia de diferenciaci&#xF3;n.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="3b6d0c78ad6cedf19e5ab9ec91139e56" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2fb69ff6-4344-4f0d-a194-b29178226d89,a53d4d95-2d74-4e38-9a72-43cd93ff2968,3a24b5c6-d4ae-4b3b-a177-ca31ba60b196,4fd3456c-f75a-4ff1-9777-e767424aea7d</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>3e93cd52fff1f07e5790cadd50bfd074</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En las estrategias de liderazgo en costes,&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2fb69ff6-4344-4f0d-a194-b29178226d89">
              <material>
                <mattext texttype="text/html">La empresa ofrece un producto o un servicio diferenciado con un coste alto</mattext>
              </material>
            </response_label>
            <response_label ident="a53d4d95-2d74-4e38-9a72-43cd93ff2968">
              <material>
                <mattext texttype="text/html">La empresa ofrece un producto o un servicio diferenciado con un coste bajo</mattext>
              </material>
            </response_label>
            <response_label ident="3a24b5c6-d4ae-4b3b-a177-ca31ba60b196">
              <material>
                <mattext texttype="text/html">La empresa ofrece un producto o un servicio similar al de los competidores con un coste alto</mattext>
              </material>
            </response_label>
            <response_label ident="4fd3456c-f75a-4ff1-9777-e767424aea7d">
              <material>
                <mattext texttype="text/html">La empresa ofrece un producto o un servicio similar al de los competidores con un coste bajo</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4fd3456c-f75a-4ff1-9777-e767424aea7d</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En la estrategia de liderazgo de costes pura la empresa ofrece un producto similar al de los competidores pero a un precio inferior. Cuando el producto es diferenciado o considerado &#xFA;nico por el cliente se tratar&#xED;a de una estrategia de diferenciaci&#xF3;n.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="34a2a4e783a446a6d6cf3e73d6cc66d5" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>a65d797e-bb8c-4dac-8d02-b9a5fed1acf5,e921a68e-58c3-4f92-9ca1-d56467934314,101a6c7f-e1fb-4a11-98f0-516153d9da34</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d03d2a81e61851edf601ed3ac4503b82</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La estrategia debe estar basada en una ventaja competitiva sostenible en el largo plazo y que no pueda ser atacada por los competidores.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="a65d797e-bb8c-4dac-8d02-b9a5fed1acf5">
              <material>
                <mattext texttype="text/html">Por tanto, la ventaja competitiva no debe poder ser atacada por los competidores</mattext>
              </material>
            </response_label>
            <response_label ident="e921a68e-58c3-4f92-9ca1-d56467934314">
              <material>
                <mattext texttype="text/html">Por muy fuerte que sea, la ventaja ser&#xE1; atacada por la competencia antes o despu&#xE9;s. La estrategia ser&#xE1; mejor cuanto m&#xE1;s tarde ataque la competencia.</mattext>
              </material>
            </response_label>
            <response_label ident="101a6c7f-e1fb-4a11-98f0-516153d9da34">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">e921a68e-58c3-4f92-9ca1-d56467934314</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En el largo plazo ninguna ventaja competitiva se puede considerar como inatacable. Cuanto mayor sea el plazo que esa ventaja competitiva sea sostenible ante las acciones de la competencia, mayor posibilidad de &#xE9;xito tendr&#xE1; la estrategia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="19e32ac061554c55565ff11844b385fb" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2c1aba6e-c495-4916-bb04-780f2d33fc9e,d01b412d-19eb-4e39-9fdb-91690f3ec6da,c52fae55-76ad-40bf-8797-64625359822e,eb663165-5d22-41f4-85fd-f0670c3a6129</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>be95c6064374e369a25ae1c2eca463e5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A trav&#xE9;s de una estrategia de desarrollo de mercado&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2c1aba6e-c495-4916-bb04-780f2d33fc9e">
              <material>
                <mattext texttype="text/html">La empresa introduce nuevos productos en los mercados actuales</mattext>
              </material>
            </response_label>
            <response_label ident="d01b412d-19eb-4e39-9fdb-91690f3ec6da">
              <material>
                <mattext texttype="text/html">La empresa introduce sus productos actuales en nuevos mercados</mattext>
              </material>
            </response_label>
            <response_label ident="c52fae55-76ad-40bf-8797-64625359822e">
