      </itemfeedback>
    </item>
    <item ident="84b0bf6c1e2f731d09dc03cbae80392e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>ed236bd8-9e9c-44e0-9551-b2ae27179258,aa14055e-0330-4284-be95-92fbbafe1d7f,8453572d-e6f7-4754-8e0e-1e8c3cd70018,8a8b61f4-880c-4df3-ba82-8b8653446178</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>6ade88f768561e9756adf37b1395d560</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La diversificaci&#xF3;n conglomerada se basa:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ed236bd8-9e9c-44e0-9551-b2ae27179258">
              <material>
                <mattext texttype="text/html">En productos nuevos que tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="aa14055e-0330-4284-be95-92fbbafe1d7f">
              <material>
                <mattext texttype="text/html">En productos nuevos que no tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que no tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="8453572d-e6f7-4754-8e0e-1e8c3cd70018">
              <material>
                <mattext texttype="text/html">En productos nuevos que tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que no tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="8a8b61f4-880c-4df3-ba82-8b8653446178">
              <material>
                <mattext texttype="text/html">En productos nuevos que no tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">aa14055e-0330-4284-be95-92fbbafe1d7f</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Este tipo de diversificaci&#xF3;n es el m&#xE1;s agresivo, ya que la empresa introduce nuevos productos en mercados totalmente nuevos para ella.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
