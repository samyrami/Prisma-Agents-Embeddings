          <mattext texttype="text/html">&lt;div&gt;La diferenciaci&#xF3;n de productos:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7dd1f073-3fcb-4c8b-acae-191601a03696">
              <material>
                <mattext texttype="text/html">Se basa exclusivamente en el propio producto&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="04868ec9-6b9c-417c-ab20-c79dafc9ff0d">
              <material>
                <mattext texttype="text/html">Puede ir m&#xE1;s all&#xE1; de las caracter&#xED;sticas del propio producto</mattext>
              </material>
            </response_label>
            <response_label ident="5ea27540-ab86-41c7-b048-486c81258860">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
