      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria madura:&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d95dc28c-18bb-4a60-bdbd-f3a32d3a5922">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE, GRACIAS A la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="bcedb4cc-595f-4eab-945f-acbfa752ea68">
              <material>
                <mattext texttype="text/html">La competencia internacional AUMENTA, GRACIAS A la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="447dd959-a6ef-4c5b-a6e3-dd79ad587b5a">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE, A PESAR DE la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="a39e6ba1-4893-4b39-9e18-1b9e4f06d077">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE E, A PESAR DE la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="20ce4937-df00-45a4-85cc-a8949a6c11df">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">bcedb4cc-595f-4eab-945f-acbfa752ea68</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La estandarizaci&#xF3;n del producto y la madurez tecnol&#xF3;gica llevan a un incremento de la competencia internacional.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
