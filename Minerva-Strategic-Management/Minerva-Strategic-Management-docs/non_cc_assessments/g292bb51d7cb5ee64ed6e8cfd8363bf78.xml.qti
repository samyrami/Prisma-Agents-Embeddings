        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="24987">
              <material>
                <mattext texttype="text/plain">De arriba abajo, pues hay que asegurar la coherencia.</mattext>
              </material>
            </response_label>
            <response_label ident="26153">
              <material>
                <mattext texttype="text/plain">De abajo a arriba, ya que las unidades inferiores son las que mejor conocen el negocio.</mattext>
