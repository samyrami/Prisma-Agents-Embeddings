          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Los objetivos estratégicos deben definirse de arriba a abajo, sirviendo de guía a los niveles inferiores y asegurando la coherencia entre todas las unidades.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd4c8a6411818ffae64ef3638702b7575" title="Question">
