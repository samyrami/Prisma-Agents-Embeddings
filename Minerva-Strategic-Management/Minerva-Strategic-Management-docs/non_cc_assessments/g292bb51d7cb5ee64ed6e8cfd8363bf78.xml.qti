          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>67296,28972,54518</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Si no existe congruencia entre la cultura y la estrategia…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="67296">
              <material>
                <mattext texttype="text/plain">Se debe ignorar la cultura para no aumentar el riesgo en la estrategia</mattext>
              </material>
            </response_label>
            <response_label ident="28972">
              <material>
                <mattext texttype="text/plain">Ignorar la cultura no es positivo, pero no necesariamente incrementa el riesgo</mattext>
              </material>
            </response_label>
            <response_label ident="54518">
              <material>
                <mattext texttype="text/plain">No se debe ignorar la cultura, pues eso siempre pondrá en mayor riesgo la estrategia</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">54518</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">En este tipo de situaciones, ignorar la cultura es una opción muy peligrosa e incluso inaceptable cuando hay importantes incongruencias.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g574f3c7bbba0f2fbc9c3ab26b00c4274" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>54258,31395,10368,20672</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Qué afirmación es correcta con respecto a la planificación estratégica y la planificación táctica?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="54258">
              <material>
                <mattext texttype="text/plain">Ambas abarcan periodos largos e iguales de tiempo</mattext>
              </material>
            </response_label>
            <response_label ident="31395">
              <material>
                <mattext texttype="text/plain">La planificación estratégica abarca periodos más largos</mattext>
              </material>
            </response_label>
            <response_label ident="10368">
              <material>
                <mattext texttype="text/plain">La planificación táctica abarca periodos más largos</mattext>
              </material>
            </response_label>
            <response_label ident="20672">
              <material>
                <mattext texttype="text/plain">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31395</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es la planificación estratégica la que abarca esos periodos largos de tiempo. La planificación táctica está enfocada al cumplimiento de los objetivos parciales que se hayan definido y por tanto, su periodo de tiempo es más corto.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g371f09ee1ee2e357e76641fecae78b0f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
