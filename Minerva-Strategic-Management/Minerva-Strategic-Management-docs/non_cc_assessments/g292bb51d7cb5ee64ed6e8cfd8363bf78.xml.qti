                <mattext texttype="text/plain">Condicionan la puesta en marcha de la estrategia, pero no las decisiones estratégicas</mattext>
              </material>
            </response_label>
            <response_label ident="60860">
              <material>
                <mattext texttype="text/plain">Condicionan tanto la puesta en marcha de la estrategia como las decisiones estratégicas</mattext>
