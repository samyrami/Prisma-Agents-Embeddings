            </response_label>
            <response_label ident="35956">
              <material>
                <mattext texttype="text/plain">Una vez creada, la cultura persiste y resiste al cambio</mattext>
              </material>
            </response_label>
            <response_label ident="76352">
              <material>
                <mattext texttype="text/plain">La cultura facilita implantar una nueva estrategia</mattext>
              </material>
            </response_label>
            <response_label ident="98635">
              <material>
                <mattext texttype="text/plain">Ninguna de las otras opciones es correcta</mattext>
