          <render_choice>
            <response_label ident="5994">
              <material>
                <mattext texttype="text/plain">Está centrada únicamente en el futuro</mattext>
              </material>
            </response_label>
            <response_label ident="13465">
              <material>
                <mattext texttype="text/plain">Está relacionada con el presente</mattext>
              </material>
            </response_label>
            <response_label ident="71544">
              <material>
                <mattext texttype="text/plain">Está centrada en describir el pasado</mattext>
