          <render_choice>
            <response_label ident="82471">
              <material>
                <mattext texttype="text/plain">Debe ser un compromiso exclusivo de los altos directivos de la empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="40938">
              <material>
                <mattext texttype="text/plain">Debe comprometer exclusivamente a los altos directivos y mandos intermedios</mattext>
              </material>
            </response_label>
            <response_label ident="34786">
              <material>
                <mattext texttype="text/plain">Debe ser un compromiso de todos los integrantes de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="60923">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">34786</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Todos los integrantes de la empresa deben estar comprometidos en la forma en la que se desarrollarán los negocios. La dirección debe liderar y asegurarse de que ese compromiso se extiende a toda la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g691e2ca04cee18482f4896f075cae450" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
