          <render_choice>
            <response_label ident="88921">
              <material>
                <mattext texttype="text/plain">Debe involucrar a los directivos, aunque basta con una aceptación pasiva de la estrategia impuesta por la compañía</mattext>
              </material>
            </response_label>
