    <item ident="g6d008e167fad91ae45acbe401959f08a" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>72913,68550,40386</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En el proceso de creación de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="72913">
              <material>
                <mattext texttype="text/plain">Se definen los negocios en los que está compitiendo una compañía.</mattext>
              </material>
            </response_label>
            <response_label ident="68550">
              <material>
                <mattext texttype="text/plain">Se definen los negocios en los que competirá la compañía en un futuro.</mattext>
              </material>
            </response_label>
            <response_label ident="40386">
              <material>
                <mattext texttype="text/plain">No es necesario definir los negocios en los que compite la compañía, o competirá en un futuro.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">68550</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">En el proceso de creación de una estrategia se deben definir los negocios en los que la compañía competirá en el futuro. De esta forma, se podrán enfocar los recursos para alcanzar una ventaja competitiva.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6c4d5a3172ecbceede659bb2bc837fc3" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>10088,92903,26151,31149</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En la creación de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="10088">
              <material>
                <mattext texttype="text/plain">Debe opinar y participar toda la compañía.</mattext>
              </material>
            </response_label>
            <response_label ident="92903">
              <material>
                <mattext texttype="text/plain">Sólo opinan y se involucran los directivos.</mattext>
              </material>
            </response_label>
            <response_label ident="26151">
              <material>
                <mattext texttype="text/plain">Los directivos definen la estrategia, y la estrategia es ajena al resto de la organización.</mattext>
              </material>
            </response_label>
            <response_label ident="31149">
              <material>
                <mattext texttype="text/plain">Los directivos definen la estrategia, y deben involucrar al resto de la compañía en su ejecución.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31149</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La creación de una estrategia, junto con su ejecución son funciones directivas esenciales. Corresponde por tanto a los directivos definir la estrategia e involucrar a todos los integrantes de la empresa para que su ejecución se ajuste a la definición realizada.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g569e0abd08f50ddc501a463c9c212093" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>7673,65170,28715,43700</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La visión estratégica de la empresa.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7673">
              <material>
                <mattext texttype="text/plain">Deben conocerla todos los integrantes de la empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="65170">
              <material>
                <mattext texttype="text/plain">Basta con que la conozcan los directivos intermedios.</mattext>
              </material>
            </response_label>
            <response_label ident="28715">
              <material>
                <mattext texttype="text/plain">Basta con que la conozcan los directivos de primer nivel.</mattext>
              </material>
            </response_label>
            <response_label ident="43700">
              <material>
                <mattext texttype="text/plain">Es un elemento básico de la estrategia, y por tanto debe conocerla únicamente el CEO de la compañía.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7673</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La visión estratégica debe ser conocida por todos los integrantes de la empresa, ya que las personas que la componen deben conocer hacia dónde se dirige, facilitando su compromiso con la compañía y reforzando el orgullo de sentirse parte de ella.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb3f1f20063b37b7f9fefa612ee4a9613" title="Question">
