        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El hecho de que existan grupos de consumidores con características y necesidades homogeneas, justifica la realización de:&lt;br&gt;&lt;br&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="96487">
              <material>
                <mattext texttype="text/plain">La Microsegmantación.</mattext>
              </material>
            </response_label>
            <response_label ident="21076">
              <material>
                <mattext texttype="text/plain">El Targeting.</mattext>
              </material>
            </response_label>
            <response_label ident="4303">
              <material>
                <mattext texttype="text/plain">La fijación de posicionamientos diferenciados por cada segmento de consumidores.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96487</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La microsegmentación parte de la existencia de grupos de consumidores homogéneos y diferenciados entre sí.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g58ff923f60f00dcc435d2f30eb27cd92" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>70645,10887,28091</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuál es la utilidad práctica para las empresas de la segmentación en el marketing estratégico ?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="70645">
              <material>
                <mattext texttype="text/plain">Permite a la empresa adaptar mejor su oferta.</mattext>
              </material>
            </response_label>
            <response_label ident="10887">
              <material>
                <mattext texttype="text/plain">Reduce el coste de sus acciones de comunicación al dirigirse a grupos objetivos más limitados</mattext>
              </material>
            </response_label>
            <response_label ident="28091">
              <material>
                <mattext texttype="text/plain">Limita el riesgo de fabricar más productos de los realmente demandados.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">70645</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La segmentación de consumidores permite a las empresas adaptar mejor su oferta a las necesidades de los consumidores.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga02a0677708ce3259efb5a0c26cacbc7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>85886,38525,28219</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿En qué consiste la estrategia de Micromarketing en la acción de Targeting?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="85886">
              <material>
                <mattext texttype="text/plain">En aquella en que los consumidores se agrupan en grupos de tamaño limitado para que sea más sencillo actuar sobre ellos.</mattext>
              </material>
            </response_label>
            <response_label ident="38525">
              <material>
                <mattext texttype="text/plain">En la realización continua y constante de pequeñas acciones de marketing dirigidas a los consumidores.</mattext>
              </material>
            </response_label>
            <response_label ident="28219">
              <material>
                <mattext texttype="text/plain">En aquella en la que la empresa se dirige a los consumidores de una manera personalizada.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28219</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El principal beneficio derivado de la microsegmentación es la posibilidad de dirigirse de una manera individual a los consumidores.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g57a74967073db6d6b0e611c5913d467e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
