    <item ident="g41336cc22aeb0c62adfc2c786417934d" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>88780,3432,86753</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Es posible para una gran empresa multinacional satisfacer las necesidades de todos los consumidores?&lt;br&gt;&lt;br&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="88780">
              <material>
                <mattext texttype="text/plain">Si, siempre que tenga la capacidad productiva suficiente.</mattext>
              </material>
            </response_label>
            <response_label ident="3432">
              <material>
                <mattext texttype="text/plain">No, no es posible.</mattext>
              </material>
            </response_label>
            <response_label ident="86753">
              <material>
                <mattext texttype="text/plain">Si, siempre que lo que los consumidores demanden sea un producto único y estándar.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3432</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Ninguna empresa, por grande que sea, tiene capacidad para satisfacer las necesidades y demandas de todos los consumidores. Es necesario segmentarlos en grupos homogéneos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g19e220a087276e6bc52a519cc84a637e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>19077,48049,34394</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿A qué corresponde el término “segmentación de los consumidores”?&lt;br&gt;&lt;br&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="19077">
              <material>
                <mattext texttype="text/plain">A agrupar a los consumidores en conjuntos más pequeños sobre los que sea más sencillo actuar.</mattext>
              </material>
            </response_label>
            <response_label ident="48049">
              <material>
                <mattext texttype="text/plain">A seleccionar, de entre los segmentos en los que se puede dividir a los consumidores, los más interesantes para una empresa determinada.</mattext>
              </material>
            </response_label>
            <response_label ident="34394">
              <material>
                <mattext texttype="text/plain">A dividir a los consumidores en grupos homogéneos pero diferenciados entre si sobre los que se pueda actuar.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">34394</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La segmentación en marketing consiste en dividir a los consumidores en grupos homogéneos y diferenciados sobre los que se pueda actuar.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gcc8ca3194629fe68ffba3e7c862224b1" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4687,22775,52953</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Qué se entiende en marketing por posicionamiento?&lt;br&gt;&lt;br&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4687">
              <material>
                <mattext texttype="text/plain">A pagar por colocar un producto en un lugar preferente en los estantes de los supermercados.</mattext>
              </material>
            </response_label>
            <response_label ident="22775">
              <material>
                <mattext texttype="text/plain">Mejorar la visibilidad de un producto en una búsqueda realizada a través de un buscador de internet.</mattext>
              </material>
            </response_label>
            <response_label ident="52953">
              <material>
                <mattext texttype="text/plain">A conseguir que el consumidor recuerde un producto de una manera clara y basándose en una de sus características básicas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">52953</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El “Posicionamiento” corresponde al hueco que una marca ocupa en la mente de sus consumidores y está basado en su ventaja competitiva.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0623e3dcf21776926eb18733ffecb901" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
