          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Desde un punto de vista de marketing, los blogs son importantes por:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73389">
              <material>
                <mattext texttype="text/plain">Están influyendo en la conducta de los consumidores respecto de las compras.</mattext>
              </material>
            </response_label>
            <response_label ident="97594">
              <material>
                <mattext texttype="text/plain">Venden espacio publicitario y se han convertido en importantes vehículos publicitarios en sí mismos.</mattext>
              </material>
            </response_label>
            <response_label ident="86179">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">86179</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Por ambas razones los blogs son importantes tanto por su capacidad de influir como por su capacidad para congregar potenciales usuarios de nuestro producto o servicio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g6038aba2625ab46695a151853785f40c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
