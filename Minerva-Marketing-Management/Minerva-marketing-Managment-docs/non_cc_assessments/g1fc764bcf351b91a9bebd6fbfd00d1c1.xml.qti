          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Estas palabras suelen ser demasiado amplias y pueden dar lugar a clicks de usuarios que no están realmente interesados en nuestro producto o servicio. Por esta razón, los resultados serán mejores utilizando palabras más específicas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
