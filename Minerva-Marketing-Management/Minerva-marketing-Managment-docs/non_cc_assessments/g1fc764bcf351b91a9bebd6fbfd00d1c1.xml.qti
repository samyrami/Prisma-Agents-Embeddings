          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La parte perversa de las redes sociales es...&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="37985">
              <material>
                <mattext texttype="text/html">Ninguna.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="73392">
              <material>
                <mattext texttype="text/html">Que son gratuitas para los usuarios.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="69203">
              <material>
                <mattext texttype="text/plain">La pérdida de control de la información.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">69203</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La pérdida de control de la información es algo que puede causar problemas y conceptos como la muerte digital, son temas de preocupación en los países más garantistas.&amp;nbsp;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb9c9916c369e52389b5a37d53121de2f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>95371,74931,16158</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Para qué tiene que estar una empresa en las redes sociales?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95371">
              <material>
                <mattext texttype="text/plain">Para poder determinar unos objetivos en redes sociales, es necesario poseer metas y objetivos empresariales en su conjunto.</mattext>
              </material>
            </response_label>
            <response_label ident="74931">
              <material>
                <mattext texttype="text/html">Los objetivos de social media marketing serán los objetivos relacionados con las redes sociales, integrados dentro de los objetivos empresariales.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="16158">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">16158</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Los objetivos de las redes sociales se encuentran integrados dentro de los objetivos empresariales.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g809637e0dbf79aad09d6846d242b27d0" title="Question">
      <itemmetadata>
        <qtimetadata>
