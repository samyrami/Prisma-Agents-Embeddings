    <item ident="gb15d63c5d0ce129a362f6294bafc806f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>57552,3265,89490</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La llamada Web 2.0. hace referencia a:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="57552">
              <material>
                <mattext texttype="text/plain">Una segunda generación en la historia del desarrollo de la tecnología web.</mattext>
              </material>
            </response_label>
            <response_label ident="3265">
              <material>
                <mattext texttype="text/plain">La base de la web 2.0. son comunidades de usuarios y una gama especial de servicios, como las redes sociales, los blogs, los wikis, etc.</mattext>
              </material>
            </response_label>
            <response_label ident="89490">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">89490</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La web 2.0 es una evolución de la web que permite una mayor interacción entre usuarios.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ga698b7eae7cf4fa2a04f15349944183e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>73130,28633,4480</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El modelo de marketing de las actuales redes sociales es a diferencia del tradicional:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="73130">
              <material>
                <mattext texttype="text/plain">Un modelo pull, en el cual el consumidor es quien tira del contenido, es la gente quien manda en el medio digital.</mattext>
              </material>
            </response_label>
            <response_label ident="28633">
              <material>
                <mattext texttype="text/plain">Un modelo igual al marketing off line.</mattext>
              </material>
            </response_label>
            <response_label ident="4480">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">73130</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es un modelo en donde el usuario tiene la capacidad de seleccionar el qué y el cuándo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g24e91f92abd85161a2cf749d7f7af763" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91100,59872,18718</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Las redes sociales ganan cada día mayor protagonismo en la actividad comunicativa de empresas, instituciones y todo tipo de entidades. Pero los millones de mensajes que corren a diario por esos canales, con especial atención al Twitter, son un arma de doble filo:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91100">
              <material>
                <mattext texttype="text/plain">Si son positivos, pueden ayudar a reforzar la imagen de esa empresa o a aumentar las ventas de una marca; pero si son negativos, se produce el efecto contrario.</mattext>
              </material>
            </response_label>
            <response_label ident="59872">
              <material>
                <mattext texttype="text/plain">Controlar toda esa información o dirigirla hacia unos intereses determinados parece una tarea imposible, aunque hay que diferenciar el tráfico orgánico más difícil de controlar por el community manager de las impresiones pagadas.</mattext>
              </material>
            </response_label>
            <response_label ident="18718">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">18718</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Tal y como hemos visto el uso de las redes sociales es un elemento de comunicación clave para nuestras marca y producto pero hay que tener una estrategia que use tanto la comunicación orgánica como la pagada.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9a0f0c9b73e0562ace8edf106fb23ffa" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
