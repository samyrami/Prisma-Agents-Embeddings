      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Qué es el crowdsourcing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="69370">
              <material>
                <mattext texttype="text/html">Es el beneficio derivado del uso de redes sociales.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="9428">
              <material>
                <mattext texttype="text/html">Es la capacidad de reunir a grupos de gente alrededor de una marca y de que trabajen para desarrollar productos y/o soluciones.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="73307">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9428</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es una oportunidad que nos brinda el poder intercambiar ideas y opiniones de manera masiva a través de las redes sociales.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9e6f501b592761914d2b100c00acbef5" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>33175,97468,29910</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los principales desafíos que plantean las redes sociales al marketing son:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="33175">
              <material>
                <mattext texttype="text/plain">Quitan tiempo a los medios tradicionales.</mattext>
              </material>
            </response_label>
            <response_label ident="97468">
              <material>
                <mattext texttype="text/plain">Han cambiado el modo en que los consumidores se enteran de cosas y deciden sobre los productos que van a comprar.</mattext>
              </material>
            </response_label>
            <response_label ident="29910">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">29910</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Son los principales desafíos que las redes sociales plantean al marketing tradicional: reducción del tiempo y capacidad de modificar la toma de decisiones.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gdd79affc04dbf943be84a4c276df6c9f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
