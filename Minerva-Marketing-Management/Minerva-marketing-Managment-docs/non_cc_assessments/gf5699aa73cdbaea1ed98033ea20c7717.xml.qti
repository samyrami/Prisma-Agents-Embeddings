    <item ident="g1a4eb2ea7c8b77c2b1732de0eed5e985" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>25830,56481,8879,56476</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los cambios sociales se producen siempre por motivos políticos y económicos…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="25830">
              <material>
                <mattext texttype="text/plain">Verdadero.</mattext>
              </material>
            </response_label>
            <response_label ident="56481">
              <material>
                <mattext texttype="text/plain">No nunca. Son independientes.</mattext>
              </material>
            </response_label>
            <response_label ident="8879">
              <material>
                <mattext texttype="text/plain">Son aleatorios. A veces sí…. A veces no.</mattext>
              </material>
            </response_label>
            <response_label ident="56476">
              <material>
                <mattext texttype="text/plain">No siempre es cierto. Hay movimientos sociales que influyen en el mercado y no tienen causas económicas o políticas directas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">56476</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">No es cierto que los cambios sociales se originen siempre por motivos políticos o económicos. Hay movimientos sociales que influyen en el mercado y no tienen causas económicas o políticas directas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
