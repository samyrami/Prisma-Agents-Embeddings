      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando hablamos de los l&#xED;mites de la automatizaci&#xF3;n en los procesos que se ceden a los clientes podemos decir.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9de9e52c-ebf7-4ced-abca-c12b6d71b040">
              <material>
                <mattext texttype="text/html">No existen l&#xED;mites en las capacidades de las personas.</mattext>
              </material>
            </response_label>
            <response_label ident="ba9707ed-08d8-48f2-b2f2-cf5ed976e4b6">
              <material>
                <mattext texttype="text/html">Mientras todo funciona como se prev&#xE9; por parte de las empresas pero la situaci&#xF3;n es cr&#xED;tica cada vez que los servicios automatizados no funcionan o el consumidor no consigue co-producir correctamente.</mattext>
              </material>
            </response_label>
            <response_label ident="3bb88745-b596-428d-8b96-8df743b076f0">
              <material>
                <mattext texttype="text/html">Ninguno.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">ba9707ed-08d8-48f2-b2f2-cf5ed976e4b6</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La respuesta es correcta porque la situaci&#xF3;n es cr&#xED;tica cada vez que los servicios automatizados no funcionan o que el consumidor no consigue co-producir correctamente.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="7b148ba94253018248732b013ed004ee" title="Question">
