      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;El Net Promoter Score (NPS) es un criterio est&#xE1;ndar de medida de...?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2181f3dd-94f0-43b7-bbcc-81c303053928">
              <material>
                <mattext texttype="text/html">Calidad.</mattext>
              </material>
