              <material>
                <mattext texttype="text/html">La probabilidad de que recomienden la compa&#xF1;&#xED;a en general.</mattext>
              </material>
            </response_label>
            <response_label ident="1e0fd825-ddb9-49bb-90e4-d9510458d9b4">
              <material>
                <mattext texttype="text/html">&amp;nbsp;Ambos.</mattext>
