      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La autoproducci&#xF3;n dirigida es &#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1433f2c5-f544-440f-8697-2b16f04bbedd">
              <material>
                <mattext texttype="text/html">Consiste en la realizaci&#xF3;n de tareas suficientemente sencillas para poder ser realizadas por el mismo consumidor o usuario de nuestro producto o servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="fc6c4663-b8c1-40d3-bb30-05cc08aa0102">
              <material>
                <mattext texttype="text/html">Produce un valor para la empresa y reemplaza parcialmente el trabajo que hac&#xED;an los profesionales por la colaboraci&#xF3;n del cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="086efb54-dab3-49f0-9dab-bbe2391e54c3">
              <material>
                <mattext texttype="text/html">Ambos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">086efb54-dab3-49f0-9dab-bbe2391e54c3</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La respuesta es correcta porque el consumidor realiza s&#xF3;lo, con la ayuda de una herramienta m&#xE1;s o menos &#x201C;inteligente&#x201D; un trabajo operativo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
