      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Entre los m&#xE9;todos que una empresa utiliza para recoger informaci&#xF3;n se encuentran&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="84a53b95-68f8-4b87-ac9a-a7816aa90e29">
              <material>
                <mattext texttype="text/html">Los m&#xE9;todos cl&#xE1;sicos de recuperaci&#xF3;n de la informaci&#xF3;n (encuestas, cuestionarios a rellenar de varias formas, focus groups)</mattext>
              </material>
            </response_label>
            <response_label ident="0ee72994-df8c-463c-aae2-e271b2a9e6d7">
              <material>
                <mattext texttype="text/html">Por otro lado, Internet permite extraer informaci&#xF3;n del consumidor tanto de manera determin&#xED;stica como probabil&#xED;stica.</mattext>
              </material>
            </response_label>
            <response_label ident="97b67a7b-f25b-4388-bd78-96cd03ced247">
              <material>
                <mattext texttype="text/html">Ambas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">97b67a7b-f25b-4388-bd78-96cd03ced247</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La respuesta es correcta porque son dos de los m&#xE9;todos en que una empresa puede obtener informaci&#xF3;n de sus consumidores, aunque no las &#xFA;nicas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="1b901722ce70816e9796d46ab00ba7d2" title="Question">
      <itemmetadata>
        <qtimetadata>
