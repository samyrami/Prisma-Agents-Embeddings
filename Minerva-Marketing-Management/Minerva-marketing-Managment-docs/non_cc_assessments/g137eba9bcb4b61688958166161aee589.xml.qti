      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Las funciones de un canal de distribuci&#xF3;n ser&#xED;an:&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="fb9eaad6-ce33-4683-a2cb-e971ae65de51">
              <material>
                <mattext texttype="text/html">La funci&#xF3;n principal del canal de distribuci&#xF3;n es mostrar la proposici&#xF3;n de valor frente a la competencia.</mattext>
              </material>
            </response_label>
            <response_label ident="8190997b-c72d-4052-9f42-162e7ecad808">
              <material>
                <mattext texttype="text/html">Reunir informaci&#xF3;n y distribuir informaci&#xF3;n de inteligencia acerca del consumidor y del entorno necesaria para planificar, hacer promoci&#xF3;n, encontrar potenciales compradores y adecuar la oferta.</mattext>
              </material>
            </response_label>
            <response_label ident="d284fd14-41de-4c4f-80f3-d52563e0a1d0">
              <material>
                <mattext texttype="text/html">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8190997b-c72d-4052-9f42-162e7ecad808</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La funci&#xF3;n principal de la distribuci&#xF3;n es acercar el producto o servicio al consumidor y recoger la informaci&#xF3;n necesaria para poder adaptar la oferta.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
