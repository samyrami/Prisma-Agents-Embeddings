      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El canal que utiliza el marketing mix de un producto para llegar al consumidor&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31ab6be1-070d-406a-93e6-0bc34ba7125d">
              <material>
                <mattext texttype="text/html">No afecta a la percepci&#xF3;n del producto por parte del consumidor.</mattext>
              </material>
            </response_label>
            <response_label ident="0edfa961-89f5-4858-9cd4-cd5ce1864523">
              <material>
                <mattext texttype="text/html">Incluye en la consideraci&#xF3;n que el consumidor tiene del producto.</mattext>
              </material>
            </response_label>
            <response_label ident="bba7b02d-7e59-4c3e-b174-dea098cad896">
              <material>
                <mattext texttype="text/html">Ambas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">0edfa961-89f5-4858-9cd4-cd5ce1864523</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El canal es otra parte del marketing mix y representa para el cliente una percepci&#xF3;n particular sobre el producto o servicio que va a comprar.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="c9ec0d1a95a955b159266a409c7baba7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
