    <item ident="820e3a908493dd220aec3afc48fb1f23" title="Pregunta">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>fa51abdf-d898-4602-b6a5-7e4e0bb140fe,d395a976-bf00-49e8-a1f4-561649696d31,28619d5a-8687-4a2b-a95b-d5268cf52471</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>fa5332caba3030513b6077b709cedab1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Si tuvi&#xE9;ramos que resumir, &#xBF;Qu&#xE9; es la distribuci&#xF3;n dentro del marketing operativo?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="fa51abdf-d898-4602-b6a5-7e4e0bb140fe">
              <material>
                <mattext texttype="text/html">El canal de distribuci&#xF3;n desplaza bienes y servicios de los productores a los consumidores.</mattext>
              </material>
            </response_label>
            <response_label ident="d395a976-bf00-49e8-a1f4-561649696d31">
              <material>
                <mattext texttype="text/html">Acercar mediante una experiencia de compra en un lugar y tiempo el producto o servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="28619d5a-8687-4a2b-a95b-d5268cf52471">
              <material>
                <mattext texttype="text/html">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">28619d5a-8687-4a2b-a95b-d5268cf52471</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En ambas respuestas tenemos lo fundamental a lo que debe responder la distribuci&#xF3;n de un Plan de Marketing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="24d59d5acaa1f5ffdb8080d2afe40be7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9c307099-5f82-43f1-83d7-94954051faba,0c998dd6-0cfd-4fad-917d-49786f1032f9,72f5aa0c-aa10-4abb-82f2-bef3f3c3eb23</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>99020558e54553d4fff45bd5c654baf4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; factores, entre otros, pueden garantizar que un cliente vuelva a un establecimiento?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9c307099-5f82-43f1-83d7-94954051faba">
              <material>
                <mattext texttype="text/html">La cantidad de dinero invertido en publicidad.</mattext>
              </material>
            </response_label>
            <response_label ident="0c998dd6-0cfd-4fad-917d-49786f1032f9">
              <material>
                <mattext texttype="text/html">La calidad del producto, la relaci&#xF3;n con el precio y la calidad del servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="72f5aa0c-aa10-4abb-82f2-bef3f3c3eb23">
              <material>
                <mattext texttype="text/html">La ubicaci&#xF3;n del establecimiento.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">0c998dd6-0cfd-4fad-917d-49786f1032f9</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura EL COSTE DE CAPTAR VERSUS EL COSTE DE FIDELIZAR la respuesta correcta es la b) La calidad del producto, la relaci&#xF3;n con el precio y la calidad del servicio. la fidelizaci&#xF3;n trabaja con la base de unos clientes ya captados, a los que se conoce y se identifica, pudi&#xE9;ndoles ofrecer productos, servicios, promociones y precios adaptados a sus gustos y necesidades</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="d0b852a113724d4dd1d2d2e0568f4f65" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1f9b3c4e-f87c-457f-a2e8-b6c4a4446051,c84ec3ff-1c6b-473c-a857-2fdffe48ff65,54a49a44-0aa7-4c86-8e11-789fff37b7ce,3b0ce3b3-bb6c-43e4-ac8c-7e4c52566566</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>a2c6a0617433e5427472c1a34322e0f4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Seg&#xFA;n sobre EL COSTE DE CAPTAR VERSUS EL COSTE DE FIDELIZAR &#xBF;Cu&#xE1;l es una ventaja de la fidelizaci&#xF3;n sobre la captaci&#xF3;n de clientes?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1f9b3c4e-f87c-457f-a2e8-b6c4a4446051">
              <material>
                <mattext texttype="text/html">La fidelizaci&#xF3;n es m&#xE1;s f&#xE1;cil que la captaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="c84ec3ff-1c6b-473c-a857-2fdffe48ff65">
              <material>
                <mattext texttype="text/html">La fidelizaci&#xF3;n es menos costosa que la captaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="54a49a44-0aa7-4c86-8e11-789fff37b7ce">
              <material>
                <mattext texttype="text/html">La fidelizaci&#xF3;n requiere menos comunicaci&#xF3;n con los clientes.</mattext>
              </material>
            </response_label>
            <response_label ident="3b0ce3b3-bb6c-43e4-ac8c-7e4c52566566">
              <material>
                <mattext texttype="text/html">La fidelizaci&#xF3;n garantiza siempre el &#xE9;xito de una empresa.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">c84ec3ff-1c6b-473c-a857-2fdffe48ff65</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura EL COSTE DE CAPTAR VERSUS EL COSTE DE FIDELIZAR la respuesta correcta es la b) La fidelizaci&#xF3;n es menos costosa que la captaci&#xF3;n. Un cliente fiel o fidelizado garantiza, en buena medida, que compre de nuevo en el futuro, que hable bien de las empresas de las que es cliente y que est&#xE9; dispuesto a acudir a ellas ante una necesidad. Esto se puede lograr, y depende, entre otros factores, de la calidad del producto, de su relaci&#xF3;n con el precio, de la imagen de marca y de la calidad del servicio que estemos dispuestos a ofrecer.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="9f5e587480545a9643f19ee2ddd9691f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>519a0ceb-ccfa-41f6-aeb1-d1ea21c6ece8,e4a38820-3d71-41ce-b3dc-1c67452f6591,5cf735a2-23e8-462d-9435-e8ba400f4e5f,0bc07800-e1e4-4f20-9700-c40c38f5604e</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>fd5b5b70b3cc921104c91904fcc1a781</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;En qu&#xE9; momento las organizaciones se orientan principalmente a la captaci&#xF3;n de clientes?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="519a0ceb-ccfa-41f6-aeb1-d1ea21c6ece8">
              <material>
                <mattext texttype="text/html">En los momentos iniciales de su actividad.</mattext>
              </material>
            </response_label>
            <response_label ident="e4a38820-3d71-41ce-b3dc-1c67452f6591">
              <material>
                <mattext texttype="text/html">Cuando tienen una base s&#xF3;lida de clientes.</mattext>
              </material>
            </response_label>
            <response_label ident="5cf735a2-23e8-462d-9435-e8ba400f4e5f">
              <material>
                <mattext texttype="text/html">Cuando deciden lanzar nuevos productos.</mattext>
              </material>
            </response_label>
            <response_label ident="0bc07800-e1e4-4f20-9700-c40c38f5604e">
              <material>
                <mattext texttype="text/html">Al alcanzar su madurez en el mercado.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">519a0ceb-ccfa-41f6-aeb1-d1ea21c6ece8</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura EL COSTE DE CAPTAR VERSUS EL &amp;nbsp;COSTE DE FIDELIZAR la respuesta correcta es la a) En los momentos iniciales de su actividad. Las organizaciones se orientan a la captaci&#xF3;n en los momentos iniciales de su actividad. En principio, ning&#xFA;n negocio nace teniendo clientes, como nadie nace sabiendo. Podremos tener cierta facilidad de acceso o de captaci&#xF3;n de los primeros clientes, porque venimos recomendados por una referencia o porque algunos clientes esperan la apertura de nuestro negocio debido a la escasez de negocios de ese tipo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="943e864c4287147e18b025f48605ed6e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4fed8aba-ba1d-405b-9175-36b1f392b1e0,75c916d5-b107-4a10-aa7c-3bbc1acb7010,03ec8c6f-f4b4-4411-a4f0-21ddcc3bca7c,daa6fd66-0db8-4ae0-a18e-4de22eff5b00</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d1bbca70a8f92bed2c14bc8c891c2014</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; es un comportamiento leal de un cliente seg&#xFA;n el CLIENTIING y la lealtad de los clientes?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4fed8aba-ba1d-405b-9175-36b1f392b1e0">
              <material>
                <mattext texttype="text/html">Cambiar de proveedor frecuentemente.</mattext>
              </material>
            </response_label>
            <response_label ident="75c916d5-b107-4a10-aa7c-3bbc1acb7010">
              <material>
                <mattext texttype="text/html">Ser sensible al precio.</mattext>
              </material>
            </response_label>
            <response_label ident="03ec8c6f-f4b4-4411-a4f0-21ddcc3bca7c">
              <material>
                <mattext texttype="text/html">Actuar como prescriptor de la empresa entre sus c&#xED;rculos de influencia.</mattext>
              </material>
            </response_label>
            <response_label ident="daa6fd66-0db8-4ae0-a18e-4de22eff5b00">
              <material>
                <mattext texttype="text/html">Evitar comprar productos adicionales de la empresa.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">03ec8c6f-f4b4-4411-a4f0-21ddcc3bca7c</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura CLIENTING Y LA LEALTAD DE LOS CLIENTES la respuesta correcta es la c) Actuar como prescriptor de la empresa entre sus c&#xED;rculos de influencia. La lealtad de los clientes conceptualmente contempla cinco aspectos que est&#xE1;n relacionados con los periodos y la intensidad de las compras, predisposici&#xF3;n para comprar otros productos de la empresa, escasa sensibilidad al precio, colaboraci&#xF3;n para mejorar el los procesos, y desde &amp;nbsp;luego. Conseguir que un cliente act&#xFA;e de prescriptor de la empresa entre sus c&#xED;rculos de influencia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ea3643a7eeb28804431a342c912a8c79" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9ab3f083-44b6-4edf-be8d-58b4cae15c15,b8340c5c-32f4-4ce1-bb2a-827e31049834,3ed75272-d922-42b7-a49f-adda9182a9a0,fd0910a3-c645-410c-b5d0-98dad3479aaa</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>59b49c678028761abf3569af1fb311c5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Seg&#xFA;n el CLIENTING y la lealtad de los clientes, &#xBF;Qu&#xE9; se busca al dise&#xF1;ar servicios de calidad?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9ab3f083-44b6-4edf-be8d-58b4cae15c15">
              <material>
                <mattext texttype="text/html">Reducir los costos de producci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="b8340c5c-32f4-4ce1-bb2a-827e31049834">
              <material>
                <mattext texttype="text/html">Diferenciar en el servicio postventa y personalizar la oferta seg&#xFA;n las necesidades del cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="3ed75272-d922-42b7-a49f-adda9182a9a0">
              <material>
                <mattext texttype="text/html">Aumentar el precio de los productos.</mattext>
              </material>
            </response_label>
            <response_label ident="fd0910a3-c645-410c-b5d0-98dad3479aaa">
              <material>
                <mattext texttype="text/html">Incrementar la producci&#xF3;n sin considerar al cliente.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">b8340c5c-32f4-4ce1-bb2a-827e31049834</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura CLIENTING Y LA LEALTAD DE LOS CLIENTES la respuesta correcta es la b) Diferenciarse en el servicio postventa y personalizar la oferta seg&#xFA;n las necesidades del cliente. Cuando la diferenciaci&#xF3;n de los servicios de venta, sean antes, durante o despu&#xE9;s de ella, no existe, las barreras de salida para los clientes son escasas y, por tanto, la capacidad para retener a los clientes es m&#xED;nima. Dise&#xF1;ar servicios de calidad, integrando los sistemas de atenci&#xF3;n al cliente y los sistemas de gesti&#xF3;n, tiene como consecuencia la personalizaci&#xF3;n del servicio y una oferta m&#xE1;s personalizada a las necesidades del cliente.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="6f151a8c3efc5365d0a4b14792f39bb6" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>dce40b75-1ec3-43ea-a943-d5bd90619bb4,66b4b781-b093-477d-a07c-b0b176da6ecb,d59d4d3f-cd71-465c-900f-1fd0290a82af,be710370-45fa-48d2-b8ff-a20204a4dccb</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>1ab7387d7e2233be3b2d790f1447dce0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;l es la primera fase del proceso de clienting?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="dce40b75-1ec3-43ea-a943-d5bd90619bb4">
              <material>
                <mattext texttype="text/html">Dise&#xF1;ar servicios de calidad.</mattext>
              </material>
            </response_label>
            <response_label ident="66b4b781-b093-477d-a07c-b0b176da6ecb">
              <material>
                <mattext texttype="text/html">Evaluar los planes.</mattext>
              </material>
            </response_label>
            <response_label ident="d59d4d3f-cd71-465c-900f-1fd0290a82af">
              <material>
                <mattext texttype="text/html">Escuchar al cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="be710370-45fa-48d2-b8ff-a20204a4dccb">
              <material>
                <mattext texttype="text/html">A&#xF1;adir valor a determinados clientes.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">d59d4d3f-cd71-465c-900f-1fd0290a82af</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura CLIENTING Y LA LEALTAD DE LOS CLIENTES la respuesta correcta es la c) Escuchar al cliente, la cual es la primera de las cinco fases. Despu&#xE9;s viene &#x201C;dise&#xF1;ar servicios de calidad&#x201D;; &#x201C;a&#xF1;adir valor a determinados clientes&#x201D;, &#x201C;ejecutar los planes dise&#xF1;ados&#x201D; y &#x201C;evaluar los planes&#x201D;. Escuchar al cliente es romper el anonimato en la compra, entender los perfiles de cada cliente y profundizar en sus necesidades a lo largo del periodo de tiempo que dura la relaci&#xF3;n entre el cliente y la empresa. &amp;nbsp;</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="9a4688afeac7db7958a91f2f283d41a7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>ece1168e-2694-4fcb-91fc-5729736e00f3,50270c87-58bd-4a3e-8f7c-9c71f81e640c,dd687bc8-0492-4939-b233-6a7320e61b00,798b5f3e-5bc3-45dc-ac67-480412a58478</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>241536d82fdfa2f6019317c183062f50</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;l es la capacidad de crecer de una empresa seg&#xFA;n el CLIENTING y la lealtad de los clientes?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ece1168e-2694-4fcb-91fc-5729736e00f3">
              <material>
                <mattext texttype="text/html">S&#xF3;lo captar nuevos clientes.</mattext>
              </material>
            </response_label>
            <response_label ident="50270c87-58bd-4a3e-8f7c-9c71f81e640c">
              <material>
                <mattext texttype="text/html">S&#xF3;lo retener a los clientes existentes.</mattext>
              </material>
            </response_label>
            <response_label ident="dd687bc8-0492-4939-b233-6a7320e61b00">
              <material>
                <mattext texttype="text/html">Captar muchos clientes y retenerlos.</mattext>
              </material>
            </response_label>
            <response_label ident="798b5f3e-5bc3-45dc-ac67-480412a58478">
              <material>
                <mattext texttype="text/html">Reducir costos de producci&#xF3;n.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">dd687bc8-0492-4939-b233-6a7320e61b00</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Respuesta correcta: Tal y como se describe en la lectura CLIENTING Y LA LEALTAD DE LOS CLIENTES la respuesta correcta es la c) Captar muchos clientes y retenerlos. La capacidad de crecer de una empresa est&#xE1; en relaci&#xF3;n directa tanto con su habilidad para captar clientes como con su destreza para conservar los que capta. Si un negocio espera ser pr&#xF3;spero, no le quedar&#xE1; otro remedio m&#xE1;s que captar muchos clientes, pero tambi&#xE9;n tendr&#xE1; que retenerlos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="8713c4d00d8846e94592ed73602abdf4" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6f062fbe-2c94-4b74-8b9f-4d567ef747a2,784693ac-02e4-425a-9056-4b4078c0131d,05f95a1a-6565-4aed-8cc9-1239e180a90e,ec186125-54bb-42ed-af8f-b61794c2fc3e</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>de7bf1c7557058611ed8e5b376be65b8</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; t&#xE9;rmino introdujo Edward Freeman y qu&#xE9; significa seg&#xFA;n la lectura &#x201C;MISI&#xD3;N Y VISI&#xD3;N COMERCIAL PARA UNA EMPRESA: CAPTACI&#xD3;N Y FIDELIZACI&#xD3;N&#x201D;?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6f062fbe-2c94-4b74-8b9f-4d567ef747a2">
              <material>
                <mattext texttype="text/html">Misi&#xF3;n, la cual describe los productos y servicios de una empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="784693ac-02e4-425a-9056-4b4078c0131d">
              <material>
                <mattext texttype="text/html">Stakeholder, que hace referencia a todos los que se ven afectados por las actividades de una empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="05f95a1a-6565-4aed-8cc9-1239e180a90e">
              <material>
                <mattext texttype="text/html">Marketing Myopia, que significa enfocarse solo en las ventas a corto plazo.</mattext>
              </material>
            </response_label>
            <response_label ident="ec186125-54bb-42ed-af8f-b61794c2fc3e">
              <material>
                <mattext texttype="text/html">Customer Relationship Management, que se refiere a la gesti&#xF3;n de las relaciones con los clientes.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">784693ac-02e4-425a-9056-4b4078c0131d</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura MISI&#xD3;N Y VISI&#xD3;N COMERCIAL PARA UNA EMPRESA: CAPTACI&#xD3;N Y FIDELIZACI&#xD3;N la respuesta correcta es la b) Stakeholder, que hace referencia a todos los que se ven afectados por las actividades de una empresa. El concepto fue utilizado la primera vez por Edward Freeman en su obra Strategic Managment , que hace referencia a todos aquellos que se ven o se pueden ver afectados por las actividades de una empresa: accionistas y propietarios, empleados, proveedores, entorno social y por supuesto clientes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="fa193ecf24d72f3991d2631c2aad4abf" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>48e74fa7-3f31-4f3d-a590-7b27aff2d186,4cc86524-8c31-48fa-8372-58368136d599,230b9ae2-f026-4ad7-9662-02c8f06253f8,841e584b-c1f7-4056-ba92-9b532e09d43d</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d5bbe7ca2248ff34344b139f679213ca</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;CAPTACI&#xD3;N Y FIDELIZACI&#xD3;N&#x201D;, &#xBF;Qu&#xE9; debe estar alineado con la misi&#xF3;n y visi&#xF3;n general de la empresa?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="48e74fa7-3f31-4f3d-a590-7b27aff2d186">
              <material>
                <mattext texttype="text/html">Los precios de los productos.</mattext>
              </material>
            </response_label>
            <response_label ident="4cc86524-8c31-48fa-8372-58368136d599">
              <material>
                <mattext texttype="text/html">La decoraci&#xF3;n de las oficinas.</mattext>
              </material>
            </response_label>
            <response_label ident="230b9ae2-f026-4ad7-9662-02c8f06253f8">
              <material>
                <mattext texttype="text/html">La misi&#xF3;n y visi&#xF3;n de los departamentos, especialmente el de ventas.</mattext>
              </material>
            </response_label>
            <response_label ident="841e584b-c1f7-4056-ba92-9b532e09d43d">
              <material>
                <mattext texttype="text/html">La ubicaci&#xF3;n de las sucursales.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">230b9ae2-f026-4ad7-9662-02c8f06253f8</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura MISI&#xD3;N Y VISI&#xD3;N COMERCIAL PARA UNA EMPRESA: CAPTACI&#xD3;N Y FIDELIZACI&#xD3;N la respuesta correcta es la c) La misi&#xF3;n y visi&#xF3;n de los departamentos, especialmente el de ventas. La Misi&#xF3;n y la Visi&#xF3;n son componentes de la formulaci&#xF3;n estrat&#xE9;gica que pueden y deben ser aplicadas a nivel departamental y, sobre todo, a nivel de un departamento tan fundamental en casi todas las empresas del mundo como es el departamento de ventas o su divisi&#xF3;n comercial.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="79b914bdc90d4a7c0d204839e55e38dd" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>bce640ab-a907-4a7c-860b-2a86251ce6af,7001a0d5-9363-44c7-9a98-85e96f6ffca1,8a215ed3-2dd6-4cc8-b12d-9c00299a4292,bbc7fcf0-d8fd-4b77-99ab-d838ae6458db</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>7a7b7ea12fcaadf11803d94861fb313a</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; significa no caer en la miop&#xED;a de marketing seg&#xFA;n Theodore Levitte?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="bce640ab-a907-4a7c-860b-2a86251ce6af">
              <material>
                <mattext texttype="text/html">Vender &#xFA;nicamente productos f&#xED;sicos sin considerar las necesidades emocionales del cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="7001a0d5-9363-44c7-9a98-85e96f6ffca1">
              <material>
                <mattext texttype="text/html">Definir la misi&#xF3;n de una empresa sin considerar la visi&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="8a215ed3-2dd6-4cc8-b12d-9c00299a4292">
              <material>
                <mattext texttype="text/html">Vender productos sin ofrecer garant&#xED;as.</mattext>
              </material>
            </response_label>
            <response_label ident="bbc7fcf0-d8fd-4b77-99ab-d838ae6458db">
              <material>
                <mattext texttype="text/html">Ofrecer una variedad excesiva de productos no relacionados.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">bce640ab-a907-4a7c-860b-2a86251ce6af</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Tal y como se describe en la lectura MISI&#xD3;N Y VISI&#xD3;N COMERCIAL PARA UNA EMPRESA: CAPTACI&#xD3;N Y FIDELIZACI&#xD3;N la respuesta correcta es la a) Vender &#xFA;nicamente productos f&#xED;sicos sin considerar las necesidades emocionales del cliente. Levitte en su obra tambi&#xE9;n se refiere al libro de Fred R. David &#x201C;La Gerencia Estrat&#xE9;gica&#x201D; en la cual escribi&#xF3; frases como &#x201C;No me ofrezc&#xE1;is cosas, sino ideas, emociones, soluciones, ambientes, sentimientos y beneficios, pero por favor no me ofrezc&#xE1;is cosas&#x201D;.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="385640a5cbecfab8db26dec5b31d6ce8" title="Question">
      <itemmetadata>
