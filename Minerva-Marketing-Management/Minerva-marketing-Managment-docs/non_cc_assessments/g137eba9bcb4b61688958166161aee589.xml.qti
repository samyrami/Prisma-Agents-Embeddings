            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La distribuci&#xF3;n como parte del marketing mix de una empresa debe incluir&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="7bafb3b0-d592-4897-84fe-0ed041747423">
              <material>
                <mattext texttype="text/html">Conocer las caracter&#xED;sticas y funcionamiento, as&#xED; como los m&#xE1;rgenes comerciales de cada intermediario.</mattext>
              </material>
            </response_label>
            <response_label ident="e1095c6f-f79e-4f18-a0a5-604a6fafed66">
              <material>
                <mattext texttype="text/html">No es una informaci&#xF3;n que la empresa pueda controlar.</mattext>
              </material>
            </response_label>
            <response_label ident="e727ffe5-b92e-4430-acf9-752f18b9d6b1">
              <material>
                <mattext texttype="text/html">Ninguna</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
