          <mattext texttype="text/html">&lt;div&gt;&#xBF;Por qu&#xE9; es necesario realizar la acci&#xF3;n del Targeting dentro del Modelo STP?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="646ace6c-fecc-4cc7-8151-e544186edd03">
              <material>
                <mattext texttype="text/html">Porque permite seleccionar los segmentos de consumidores m&#xE1;s interesantes.</mattext>
              </material>
            </response_label>
            <response_label ident="da081616-898e-49f1-a05c-30ea1af58c5a">
              <material>
                <mattext texttype="text/html">Para poder conocer en profundidad las caracter&#xED;sticas de los consumidores.</mattext>
              </material>
            </response_label>
            <response_label ident="ef24312e-791b-4e73-8288-8173f988c499">
              <material>
                <mattext texttype="text/html">Para justificar el posicionamiento del producto.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
