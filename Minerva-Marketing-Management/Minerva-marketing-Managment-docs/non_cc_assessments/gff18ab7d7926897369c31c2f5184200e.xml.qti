      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El hecho de que existan grupos de consumidores con caracter&#xED;sticas y necesidades homogeneas, justifica la realizaci&#xF3;n de:&lt;br&gt;&lt;br&gt;
&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="421fcbea-918a-45dc-b0c1-8f0c7519fa15">
              <material>
                <mattext texttype="text/html">La Microsegmantaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="2143d57c-1239-4fef-b139-78f99fa8adea">
              <material>
                <mattext texttype="text/html">El Targeting.</mattext>
              </material>
            </response_label>
            <response_label ident="2bbf6a2f-fd5f-4ccd-ac6f-c6ef4d179130">
              <material>
                <mattext texttype="text/html">La fijaci&#xF3;n de posicionamientos diferenciados por cada segmento de consumidores.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
