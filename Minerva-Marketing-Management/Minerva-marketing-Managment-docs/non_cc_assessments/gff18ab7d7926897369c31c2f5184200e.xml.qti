    <item ident="352ff61759a36265e154a0dd38fc7a28" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>d611b833-7542-43ca-a05a-c5000bfae3b6,57453a4d-8169-45d8-9b4b-0c9152c19f36,99853fe1-d646-4a2e-a171-3e119eaf9474</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>3bc4b62b1b133defc0578fe3766eaa9a</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;De qu&#xE9; factores depende principalmente el posicionamiento de un producto?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d611b833-7542-43ca-a05a-c5000bfae3b6">
              <material>
                <mattext texttype="text/html">De la situaci&#xF3;n y posicionamiento de los productos competitivos.</mattext>
              </material>
            </response_label>
            <response_label ident="57453a4d-8169-45d8-9b4b-0c9152c19f36">
              <material>
                <mattext texttype="text/html">De las opiniones de los consumidores.</mattext>
              </material>
            </response_label>
            <response_label ident="99853fe1-d646-4a2e-a171-3e119eaf9474">
              <material>
                <mattext texttype="text/html">De la ventaja competitiva.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99853fe1-d646-4a2e-a171-3e119eaf9474</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El posicionamiento depende b&#xE1;sicamente de la ventaja competitiva. La situaci&#xF3;n y posicionamiento de los competidores y las opiniones de los consumidores son importantes, pero el posicionamiento debe establecerse partiendo de la ventaja competitiva.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ec8c893bf27b89dc1833ea38c11fa117" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>0768d061-2ea9-4230-ae98-b7cfdfb15349,3d54e2bc-a796-4ee4-af22-ec88f469df26,30bf6be5-602b-4ccd-ab16-83c04413ee39</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>4abff2100cf2f6b1a0e1cd4187c37936</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;les son las fases que deben seguirse en el proceso de elaboraci&#xF3;n del posicionamiento de un producto?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="0768d061-2ea9-4230-ae98-b7cfdfb15349">
              <material>
                <mattext texttype="text/html">Investigaci&#xF3;n de la competencia, investigaci&#xF3;n del consumidor, investigaci&#xF3;n del consumidor, an&#xE1;lisis interno y elecci&#xF3;n del posicionamiento.</mattext>
              </material>
            </response_label>
            <response_label ident="3d54e2bc-a796-4ee4-af22-ec88f469df26">
              <material>
                <mattext texttype="text/html">An&#xE1;lisis de la competencia, descubrir la ventaja competitiva, elaborar la propuesta de valor y decidir el posicionamiento.</mattext>
              </material>
            </response_label>
            <response_label ident="30bf6be5-602b-4ccd-ab16-83c04413ee39">
              <material>
                <mattext texttype="text/html">Realizar un an&#xE1;lisis DAFO / SWOT, descubrir la propuesta de valor y decidir el posicionamiento.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">3d54e2bc-a796-4ee4-af22-ec88f469df26</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Los pasos que deben seguirse de una manera secuencial son An&#xE1;lisis de la competencia, descubrir la ventaja competitiva, elaborar la propuesta de valor y decidir el posicionamiento.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="bfe345a1aeef92dd191d6c566956c196" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>36b7138a-e9f8-4e2d-b69e-d191a08d557e,9c2c8d00-c739-4334-85bc-fec27fa3613b,3ddd26d9-0464-49be-99c2-8497f158316b</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>f8482b9066690e564c15b32625e85b66</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;A qu&#xE9; se entiende por &#x201C;Posicionamiento&#x201D; en marketing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36b7138a-e9f8-4e2d-b69e-d191a08d557e">
              <material>
                <mattext texttype="text/html">El lugar espec&#xED;fico que ocupa una marca en la mente de sus consumidores.</mattext>
              </material>
            </response_label>
            <response_label ident="9c2c8d00-c739-4334-85bc-fec27fa3613b">
              <material>
                <mattext texttype="text/html">A su posici&#xF3;n en el mercado, su cuota de mercado.</mattext>
              </material>
            </response_label>
            <response_label ident="3ddd26d9-0464-49be-99c2-8497f158316b">
              <material>
                <mattext texttype="text/html">El lugar que ocupa en la estanter&#xED;a de los supermercados.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">36b7138a-e9f8-4e2d-b69e-d191a08d557e</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Por posicionamiento se entiende el lugar que una marca ocupa en la mente de sus consumidores.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="b9bb16641b4a2d565c455b60b1548310" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>0c11775e-67ce-45a6-b285-942123d3eabc,c91cc67f-c3ad-4e8e-a11b-752006445ad3,2328a45c-1fa9-4977-a860-19cb5939b7ad</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>12c54d1cdd6827f73766668a139afb13</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;C&#xF3;mo conseguir que mi producto se diferencie claramente de los competidores?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="0c11775e-67ce-45a6-b285-942123d3eabc">
              <material>
                <mattext texttype="text/html">A trav&#xE9;s de una fuerte campa&#xF1;a de publicidad.</mattext>
              </material>
            </response_label>
            <response_label ident="c91cc67f-c3ad-4e8e-a11b-752006445ad3">
              <material>
                <mattext texttype="text/html">Mediante un posicionamiento claro.</mattext>
              </material>
            </response_label>
            <response_label ident="2328a45c-1fa9-4977-a860-19cb5939b7ad">
              <material>
                <mattext texttype="text/html">Pagando para conseguir una posici&#xF3;n preferente en el punto de venta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">c91cc67f-c3ad-4e8e-a11b-752006445ad3</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El posicionamiento es el elemento que diferencia a las marcas entre s&#xED;. Y la campa&#xF1;a de publicidad lo que hace es transmitir ese posicionamiento. Por &#xFA;ltimo, la posici&#xF3;n en el punto de venta no tiene nada que ver con el posicionamiento de marketing.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="e30e70c3e17bd3f0c4c23ab9064d6063" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>ecdc3f8c-4639-4252-939f-d56d424c6056,cf38c1e9-ba9a-4dc1-a537-ec096b13bf42,8e02289f-8798-427f-93c0-c6da92bc0076</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>9e014bf918fe241e7b72cb58763c8e48</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;A qu&#xE9; corresponde el &#x201C;Life Time Value&#x201D; de los clientes?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ecdc3f8c-4639-4252-939f-d56d424c6056">
              <material>
                <mattext texttype="text/html">A la suma de las ventas de todos los clientes.</mattext>
              </material>
            </response_label>
            <response_label ident="cf38c1e9-ba9a-4dc1-a537-ec096b13bf42">
              <material>
                <mattext texttype="text/html">Al importe neto de las ventas de los clientes, descontados los impuestos.</mattext>
              </material>
            </response_label>
            <response_label ident="8e02289f-8798-427f-93c0-c6da92bc0076">
              <material>
                <mattext texttype="text/html">Al valor actual neto del caudal de beneficios futuros esperados a lo largo de la vida de los clientes.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8e02289f-8798-427f-93c0-c6da92bc0076</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El LFT corresponde al valor actual neto del caudal de beneficios futuros esperados a lo largo de la vida del cliente, y se calcula restando a los beneficios esperados los costes de captaci&#xF3;n, mantenimiento y servicios.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="f3d875c38912ea1e68bbb75be2e25b6e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>150ded19-d268-4182-9696-5b2642d3e477,4661181e-158d-4a15-84e1-604f7c9345eb,c763b096-d92d-4ca3-b858-1eb3011ba965</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d2955692700735b5136f45001810ea41</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los segmentos seleccionados a trav&#xE9;s del Targeting, &#xBF;deben ser medibles?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="150ded19-d268-4182-9696-5b2642d3e477">
              <material>
                <mattext texttype="text/html">SI. Es una condici&#xF3;n indispensable que se puedan medir, tanto en lo referente a sus integrantes como en las ventas realizadas en ellos.</mattext>
              </material>
            </response_label>
            <response_label ident="4661181e-158d-4a15-84e1-604f7c9345eb">
              <material>
                <mattext texttype="text/html">No, lo realmente importante es que se puedan medir las ventas realizadas.</mattext>
              </material>
            </response_label>
            <response_label ident="c763b096-d92d-4ca3-b858-1eb3011ba965">
              <material>
                <mattext texttype="text/html">No, lo que de verdad cuenta es que los segmentos sean rentables.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">150ded19-d268-4182-9696-5b2642d3e477</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Poder medir el n&#xFA;mero de integrantes de los segmentos seleccionados, y las ventas realizadas sobre ellos es una condici&#xF3;n indispensable del Targeting.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="f670fa97e1ab3e9d732452eb9e774a2f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>2055c05f-7d14-499e-8824-e37c8ded4e51,1d1fa621-6470-4322-95b5-ae6d8911ae74,8c5bfa40-4642-4627-9abf-dd7ab910351c</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>59778e12c7e0abd66c970e272a7fbfd2</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;l es la ventaja b&#xE1;sica derivada de la realizaci&#xF3;n del Targeting?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="2055c05f-7d14-499e-8824-e37c8ded4e51">
              <material>
                <mattext texttype="text/html">Facilita las acciones del marketing de precisi&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="1d1fa621-6470-4322-95b5-ae6d8911ae74">
              <material>
                <mattext texttype="text/html">Permite una mayor rapidez en la selecci&#xF3;n del Grupo Objetivo.</mattext>
              </material>
            </response_label>
            <response_label ident="8c5bfa40-4642-4627-9abf-dd7ab910351c">
              <material>
                <mattext texttype="text/html">Permite trabajar con un menor n&#xFA;mero de consumidores.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">2055c05f-7d14-499e-8824-e37c8ded4e51</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La principal ventaja del Targeting es que permite a la empresa la realizaci&#xF3;n de acciones de marketing de precisi&#xF3;n, dado que se identifican claramente los segmentos objetivo y como consecuencia, se puede actuar mejor sobre ellos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="f71dc1f3d4f428bed8dadfa71cf34ead" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4cf36483-10bb-4165-b6c5-7ff2d02214fa,2ac71bae-5607-46a6-bb60-dc4a1b3b0a28,93f11c8f-3970-467b-9b75-f4f2bb4c673d</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>0db2287e464933a646905d785144f235</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Para realizar el proceso de Targeting, &#xBF;Qu&#xE9; debe hacer la empresa?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4cf36483-10bb-4165-b6c5-7ff2d02214fa">
              <material>
                <mattext texttype="text/html">Agrupar a los consumidores en grupos homog&#xE9;neos.</mattext>
              </material>
            </response_label>
            <response_label ident="2ac71bae-5607-46a6-bb60-dc4a1b3b0a28">
              <material>
                <mattext texttype="text/html">Seleccionar los segmentos sobre los que sea m&#xE1;s sencillo actuar.</mattext>
              </material>
            </response_label>
            <response_label ident="93f11c8f-3970-467b-9b75-f4f2bb4c673d">
              <material>
                <mattext texttype="text/html">Evaluar el potencial de los diferentes segmentos, para posteriormente seleccionar los m&#xE1;s adecuados.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">93f11c8f-3970-467b-9b75-f4f2bb4c673d</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Para realizar el targeting, lo que debe hacerse es evaluar el potencial de los segmentos para seleccionar los m&#xE1;s interesantes para la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="e1adbcdc297e0471fc5b49dce01fdca1" title="Question">
