      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; es un Kpi en display marketing?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="c42440cb-7a36-41c3-adb2-b0a3356dd0e5">
              <material>
                <mattext texttype="text/html">Son indicadores que nos permiten medir, controlar y establecer los resultados, as&#xED; como poder optimizar las campa&#xF1;as en base a ellos.</mattext>
              </material>
            </response_label>
            <response_label ident="4cd318a2-4f36-4378-9160-3c4db511b315">
              <material>
                <mattext texttype="text/html">Es el acr&#xF3;nimo de un DSP.</mattext>
              </material>
            </response_label>
            <response_label ident="bf2ba4fb-494d-4441-95b2-37923cb4e1b4">
              <material>
                <mattext texttype="text/html">Ninguna es correcta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
