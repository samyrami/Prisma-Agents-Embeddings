            <fieldentry>b57ec311-6936-4b75-93e1-40067f328057,a063ad38-fef6-465b-b17f-27d959e55439,3140e4ae-49a6-40cd-91f6-bad1895e52f0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>88f3199dab6d7daf0ad2d27300e9e04e</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Qu&#xE9; se conoce como campa&#xF1;as always on?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="b57ec311-6936-4b75-93e1-40067f328057">
              <material>
                <mattext texttype="text/html">Campa&#xF1;as puntuales con objetivo de performance.</mattext>
              </material>
            </response_label>
            <response_label ident="a063ad38-fef6-465b-b17f-27d959e55439">
              <material>
                <mattext texttype="text/html">Campa&#xF1;as puntuales con objetivo de branding.</mattext>
              </material>
            </response_label>
            <response_label ident="3140e4ae-49a6-40cd-91f6-bad1895e52f0">
              <material>
                <mattext texttype="text/html">Acciones y campa&#xF1;as mixtas tanto de branding a CPM como de performance a CPC.</mattext>
