        <flow_mat>
          <material>
            <mattext texttype="text/html">El poder de los proveedores &#x2026;puede impactar la capacidad de negociaci&#xF3;n para lograr costes competitivos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
