          <mattext texttype="text/html">&lt;div&gt;La totalidad del cambio generado por la aparici&#xF3;n de nuevas herramientas para transformar el trabajo de manera optimizada&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="8ccb2afe-0293-42a3-9699-a198915dff06">
              <material>
                <mattext texttype="text/html">Puede transformar los sabores tradicionales como el del jam&#xF3;n en mantequilla.</mattext>
              </material>
            </response_label>
            <response_label ident="5adb1610-0911-4cde-ac19-83cef589c6a5">
              <material>
                <mattext texttype="text/html">Puede transformar el entorno y provocar la desaparici&#xF3;n de continentes enteros.</mattext>
              </material>
            </response_label>
            <response_label ident="8d354b3f-e5bd-4108-88cd-2010251eb196">
              <material>
                <mattext texttype="text/html">Puede cambiar de manera sustancial la velocidad de rotaci&#xF3;n terrestre.</mattext>
              </material>
            </response_label>
            <response_label ident="7e21bd03-3d27-4921-ab02-968fabd36a09">
              <material>
                <mattext texttype="text/html">Puede impactar el entorno macroecon&#xF3;mico y a su vez el negocio de las empresas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
