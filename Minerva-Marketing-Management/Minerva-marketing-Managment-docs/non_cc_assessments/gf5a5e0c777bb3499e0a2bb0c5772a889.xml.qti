          <mattext texttype="text/html">&lt;div&gt;Las Cinco Fuerzas de Porter son&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d2098e3e-fb94-40dc-8521-618f5e09e232">
              <material>
                <mattext texttype="text/html">&#x2026; fuerzas del entorno macroecon&#xF3;mico que impiden el desarrollo de una empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="694b3de5-496a-4717-89cf-64776e8976d1">
              <material>
                <mattext texttype="text/html">&#x2026; fuerzas del entorno Microecon&#xF3;mico para "calibrar" las condiciones de idoneidad a la hora de establecer una empresa en un determinado entorno.</mattext>
              </material>
            </response_label>
            <response_label ident="23ad6e17-428c-47d8-8474-a39d64003863">
              <material>
                <mattext texttype="text/html">&lt;span dir="ltr"&gt;... fuerzas del entorno socio pol&#xED;tico que condicionan el entorno&lt;/span&gt;&lt;br&gt;&lt;span dir="ltr"&gt;tecnol&#xF3;gicamente.&lt;/span&gt;</mattext>
              </material>
            </response_label>
            <response_label ident="b94e7c10-9870-482b-813f-6b129fabf662">
              <material>
                <mattext texttype="text/html">&#x2026; fuerzas del entorno social que condicionan el desarrollo de las personas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
