      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los criterios demogr&#xE1;ficos pueden servir para&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="613ff899-b570-467d-a45d-c9d231c25504">
              <material>
                <mattext texttype="text/html">Democratizar a la sociedad</mattext>
              </material>
            </response_label>
            <response_label ident="90d5be0f-5d16-4880-b3b7-bdcf6f025283">
              <material>
                <mattext texttype="text/html">Demograficar los productos del mercado.</mattext>
              </material>
            </response_label>
            <response_label ident="4a9799ae-4911-47ed-9bce-9cd2aab9ead1">
              <material>
                <mattext texttype="text/html">Entender la evoluci&#xF3;n del consumidor y tomar decisiones de inversi&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="7138f817-afc8-4066-8aa4-4644ffff1b6b">
              <material>
                <mattext texttype="text/html">Entender el car&#xE1;cter y tendencias del consumidor y adaptar el producto a sus gustos&amp;nbsp;</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4a9799ae-4911-47ed-9bce-9cd2aab9ead1</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Los criterios demogr&#xE1;ficos pueden servir para entender la evoluci&#xF3;n del consumidor y tomar decisiones de inversi&#xF3;n.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="cee84632a6f3591ccdbdd53bfa031f2f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
