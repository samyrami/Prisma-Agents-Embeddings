          <render_choice>
            <response_label ident="f8a62aa9-a151-4de6-a814-314cb3310691">
              <material>
                <mattext texttype="text/html">&#x2026; Impacta la capacidad de comercializar el producto en el mercado independientemente del precio de vent</mattext>
              </material>
            </response_label>
            <response_label ident="2f5375a5-bddb-43ca-afbf-c81115302de7">
              <material>
                <mattext texttype="text/html">&#x2026; puede impactar la capacidad de negociaci&#xF3;n para lograr costes competitivos.</mattext>
              </material>
            </response_label>
            <response_label ident="3b9a2bb6-3b04-4ee6-b90b-d9fada9ea22d">
              <material>
                <mattext texttype="text/html">... puede impactar la creatividad de la agencia de publicidad para desarrollar un anuncio original.</mattext>
              </material>
            </response_label>
            <response_label ident="8aba4d3c-614b-4a9a-94f4-c86ded208cf7">
              <material>
                <mattext texttype="text/html">&#x2026; puede impactar las relaciones familiares de los empleados en una empresa.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
