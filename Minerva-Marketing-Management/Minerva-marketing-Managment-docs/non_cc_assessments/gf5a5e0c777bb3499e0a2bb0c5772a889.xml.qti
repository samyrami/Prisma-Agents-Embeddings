          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La comunidad cultural en una zona concreta (Hispanos, Asi&#xE1;ticos)&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9c9f7fe8-98ce-4be0-b475-434b6315d5a5">
              <material>
                <mattext texttype="text/html">Es un criterio demogr&#xE1;fico del p&#xFA;blico.</mattext>
              </material>
            </response_label>
            <response_label ident="aba0c6a7-6b67-421e-b551-be3000ac48e5">
              <material>
                <mattext texttype="text/html">Es un criterio psicogr&#xE1;fico porque todos son iguales.</mattext>
              </material>
            </response_label>
            <response_label ident="cd3de182-f054-4bd7-9872-255322327c1f">
              <material>
                <mattext texttype="text/html">Refleja las aficiones profesionales de la persona.</mattext>
              </material>
            </response_label>
            <response_label ident="fd5c0483-9267-42bb-b43d-8a4de4184328">
              <material>
                <mattext texttype="text/html">Puede desviarnos de nuestros criterios de posicionamiento la edad y clase social</mattext>
              </material>
            </response_label>
            <response_label ident="3fc09ffe-ec25-4cf8-b3c4-40c2101c8642">
              <material>
                <mattext texttype="text/html">Son criterios psicogr&#xE1;ficos de descripci&#xF3;n del p&#xFA;blico.</mattext>
              </material>
            </response_label>
            <response_label ident="ce9fe76d-03e1-4d5d-acf5-76e12e4ba3af">
              <material>
                <mattext texttype="text/html">No se pueden medir.</mattext>
              </material>
            </response_label>
            <response_label ident="de3c448b-b72c-4784-bd15-65b372f18a43">
              <material>
                <mattext texttype="text/html">No son relevantes para descubrir mi consumidor objetivo.</mattext>
              </material>
            </response_label>
            <response_label ident="d9fd04d2-c93c-48c6-95a5-c7bfd134129a">
              <material>
                <mattext texttype="text/html">Ninguna de las anteriores.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9c9f7fe8-98ce-4be0-b475-434b6315d5a5</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La comunidad cultural en una zona concreta (Hispanos, Asi&#xE1;ticos) es un criterio demogr&#xE1;fico del p&#xFA;blico porque tiene la cualidad de ser perfectamente medible de acuerdo a los institutos y estudios estad&#xED;sticos locales o nacionales.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
