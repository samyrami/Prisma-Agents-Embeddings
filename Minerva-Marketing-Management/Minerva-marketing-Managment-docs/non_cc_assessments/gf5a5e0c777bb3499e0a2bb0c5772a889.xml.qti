            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>9c9f7fe8-98ce-4be0-b475-434b6315d5a5,aba0c6a7-6b67-421e-b551-be3000ac48e5,cd3de182-f054-4bd7-9872-255322327c1f,fd5c0483-9267-42bb-b43d-8a4de4184328,3fc09ffe-ec25-4cf8-b3c4-40c2101c8642,ce9fe76d-03e1-4d5d-acf5-76e12e4ba3af,de3c448b-b72c-4784-bd15-65b372f18a43,d9fd04d2-c93c-48c6-95a5-c7bfd134129a</fieldentry>
          </qtimetadatafield>
