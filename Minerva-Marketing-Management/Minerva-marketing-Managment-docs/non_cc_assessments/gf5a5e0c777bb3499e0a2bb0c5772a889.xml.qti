      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Un mercado con menos competidores&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="b7728ff3-c44d-46ab-8e69-6568f4af30a2">
              <material>
                <mattext texttype="text/html">&#x2026; siempre genera competencia agresiva.</mattext>
              </material>
            </response_label>
            <response_label ident="23a23d31-f0fd-4487-8934-bdc1edbcbc30">
              <material>
                <mattext texttype="text/html">&#x2026; siempre genera la intervenci&#xF3;n del Estado.</mattext>
              </material>
            </response_label>
            <response_label ident="fc860277-5729-46aa-b2e1-00d8bba4c4e8">
              <material>
                <mattext texttype="text/html">... posibilita el desarrollo de comportamientos "legales" donde la caballerosidad de &#xE9;stos impide conductas arriesgadas.</mattext>
              </material>
            </response_label>
            <response_label ident="f5c87168-d338-45ab-bae1-fc936edd3ad4">
              <material>
                <mattext texttype="text/html">... siempre produce violencia hacia el distribuidor.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">fc860277-5729-46aa-b2e1-00d8bba4c4e8</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Un mercado con menos competidores, posibilita el desarrollo de comportamientos &#x201C;legales&#x201D; donde la caballerosidad de &#xE9;stos impide conductas arriesgadas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="2d28a3f0ca76c24fd38a55a9148d26c2" title="Question">
      <itemmetadata>
