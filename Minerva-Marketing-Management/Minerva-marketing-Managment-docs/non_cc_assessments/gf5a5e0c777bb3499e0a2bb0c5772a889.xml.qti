    <item ident="340945b5e4b778f32953a7ab7190c452" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1d3c2fc2-cb6c-4770-955b-4e12cce4af4c,fdeeff0b-adc4-4e38-8e18-fb51b0109901,452bbf24-eb3b-4664-b6f4-8e4d6268ed29,a1f76ceb-617b-4eab-8ef0-6251c819515f</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>1b577c7a2b9e4657b841b820bd690b5f</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los cambios sociales se producen siempre por motivos pol&#xED;ticos y econ&#xF3;micos&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1d3c2fc2-cb6c-4770-955b-4e12cce4af4c">
              <material>
                <mattext texttype="text/html">Verdadero.</mattext>
              </material>
            </response_label>
            <response_label ident="fdeeff0b-adc4-4e38-8e18-fb51b0109901">
              <material>
                <mattext texttype="text/html">No nunca. Son independientes.</mattext>
              </material>
            </response_label>
            <response_label ident="452bbf24-eb3b-4664-b6f4-8e4d6268ed29">
              <material>
                <mattext texttype="text/html">Son aleatorios. A veces s&#xED;&#x2026;. A veces no.</mattext>
              </material>
            </response_label>
            <response_label ident="a1f76ceb-617b-4eab-8ef0-6251c819515f">
              <material>
                <mattext texttype="text/html">No siempre es cierto. Hay movimientos sociales que influyen en el mercado y no tienen causas econ&#xF3;micas o pol&#xED;ticas directas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">a1f76ceb-617b-4eab-8ef0-6251c819515f</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">No es cierto que los cambios sociales se originen siempre por motivos pol&#xED;ticos o econ&#xF3;micos. Hay movimientos sociales que influyen en el mercado y no tienen causas econ&#xF3;micas o pol&#xED;ticas directas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
