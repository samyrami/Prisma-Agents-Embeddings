      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Una oferta p&#xFA;blica para servicios sociales sanitarios con un coste cerrado, o para suministro de veh&#xED;culos de transporte tambi&#xE9;n con precio cerrado, &#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="abf840b8-647f-4307-b350-86357788c582">
              <material>
                <mattext texttype="text/html">... es lo que quiere cualquier proveedor para hacer dinero.</mattext>
              </material>
            </response_label>
            <response_label ident="a85ca312-39fd-4f9e-8bba-815469d8d4ff">
              <material>
                <mattext texttype="text/html">... facilita siempre la pluralidad de proveedores de prestigio.</mattext>
              </material>
            </response_label>
            <response_label ident="97a0f9fe-3f1c-46ac-b9cb-6177aa3f0061">
              <material>
                <mattext texttype="text/html">&#x2026; garantiza la calidad.</mattext>
              </material>
            </response_label>
            <response_label ident="951f7c4c-d468-43bd-ae4f-138447cb63a0">
              <material>
                <mattext texttype="text/html">... pueden suponer unos requisitos inalcanzables para una empresa que vive del suministro a unos pocos clientes.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">951f7c4c-d468-43bd-ae4f-138447cb63a0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Una oferta p&#xFA;blica para servicios sociales sanitarios con un coste cerrado, o para suministro de veh&#xED;culos de transporte tambi&#xE9;n con precio cerrado, pueden suponer unos requisitos inalcanzables para una empresa que vive del suministro a unos pocos clientes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
