      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El hallazgo de que la pir&#xE1;mide poblacional invertida en Europa genera un amplio grupo de consumidores de edad avanzada que necesita herramientas y accesorios para su vida de cada d&#xED;a se ha logrado a partir de criterios&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4c167e46-ae35-4979-b5c4-918a57949ff6">
              <material>
                <mattext texttype="text/html">Patentes.</mattext>
              </material>
            </response_label>
            <response_label ident="1592eee2-c37d-4171-a594-b78cec06556c">
              <material>
                <mattext texttype="text/html">Comunes.</mattext>
              </material>
            </response_label>
            <response_label ident="797ab674-b23a-43ac-8c20-c94928ccb8ed">
              <material>
                <mattext texttype="text/html">Demogr&#xE1;ficos.</mattext>
              </material>
            </response_label>
            <response_label ident="22def986-813a-4768-a8c4-89223ea55097">
              <material>
                <mattext texttype="text/html">Psicogr&#xE1;ficos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">797ab674-b23a-43ac-8c20-c94928ccb8ed</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El hallazgo de que la pir&#xE1;mide poblacional invertida en Europa genera un amplio grupo de consumidores de edad avanzada que necesita herramientas y accesorios para su vida de cada d&#xED;a se ha logrado a partir de criterios demogr&#xE1;ficos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
