          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque mide la probabilidad de que recomienden la compañía en general.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g87349ce95fb99f1250f9f67535236623" title="Question">
      <itemmetadata>
        <qtimetadata>
