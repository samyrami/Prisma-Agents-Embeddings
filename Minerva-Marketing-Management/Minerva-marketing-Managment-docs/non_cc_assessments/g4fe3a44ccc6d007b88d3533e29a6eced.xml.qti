      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Que frase se ajusta más al concepto de fijación de precio…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31561">
              <material>
                <mattext texttype="text/plain">La tecnología es condición necesaria pero no única para poder obtener el mayor margen para nuestros productos o servicios, además necesitamos el conocimiento del mercado y la intuición que nos aporta el conocimiento.</mattext>
              </material>
            </response_label>
            <response_label ident="85266">
              <material>
                <mattext texttype="text/plain">La fijación del precio tiene algo de ciencia y algo de arte.</mattext>
              </material>
            </response_label>
            <response_label ident="36789">
              <material>
                <mattext texttype="text/plain">Ambas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">36789</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es necesario un alto componente tecnológico pero siempre debe ir acompañado de la intuición humana.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
