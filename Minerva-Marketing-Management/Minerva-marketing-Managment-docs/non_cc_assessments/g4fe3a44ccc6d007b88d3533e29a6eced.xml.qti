            <fieldentry>76119,48265,59102</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La idea del crowd-sourcing se basa en…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="76119">
              <material>
                <mattext texttype="text/plain">En el modelo colaborativo, la empresa procede a una captación de actividades de valor añadido que el consumidor consiente a realizar gratuitamente.</mattext>
              </material>
            </response_label>
            <response_label ident="48265">
              <material>
                <mattext texttype="text/plain">En la capacidad de trabajar voluntariamente y crear valor para la empresa ofreciendo informaciones, comportamientos, inventos, producciones personales, contando con el apoyo de las tecnologías en red y el marketing colaborativo.</mattext>
              </material>
            </response_label>
            <response_label ident="59102">
              <material>
                <mattext texttype="text/plain">Ambos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">59102</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque en el modelo colaborativo, la empresa procede a una captación de actividades de valor añadido mediante la capacidad de trabajar voluntariamente y crear valor para la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g12a1612a53296040fb5ad801b60aebcf" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
