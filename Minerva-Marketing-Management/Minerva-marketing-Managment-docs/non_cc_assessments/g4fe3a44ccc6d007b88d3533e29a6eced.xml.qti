        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="29452">
              <material>
                <mattext texttype="text/plain">El agrado que nos proporciona el cliente después de la compra del servicio o producto.</mattext>
              </material>
            </response_label>
            <response_label ident="31754">
              <material>
                <mattext texttype="text/plain">Al nivel de conformidad de la persona cuando realiza una compra o utiliza un servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="15270">
              <material>
                <mattext texttype="text/plain">Ambos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">31754</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque la satisfacción del cliente va a significar si las expectativas creadas por el producto o servicio son cumplidas y en qué medida.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g15b73e75643f8505895db07b29e70cbf" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>41206,77821,50801</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El concepto de coproducción es una idea que hace referencia a...&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="41206">
              <material>
                <mattext texttype="text/plain">Las empresas cuentan de una manera u otra con el consumidor para tener ideas, mejorar productos o simplemente adaptar su servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="77821">
              <material>
                <mattext texttype="text/plain">El consumidor es el que interviene directamente en las diferentes etapas de la creación de valor.</mattext>
              </material>
            </response_label>
            <response_label ident="50801">
              <material>
                <mattext texttype="text/plain">Ambas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">50801</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El concepto de coproducción implica al consumidor como generador de ideas para mejorar los productos o servicios en las distintas etapas de creación de valor de los mismos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g1b57052c0375dd08566bff5cde2ec400" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>4159,17664,30849</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La mayoría de las empresas reconocen que fijar los precios en función de los costes es:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4159">
              <material>
                <mattext texttype="text/plain">Equivocado.</mattext>
              </material>
            </response_label>
            <response_label ident="17664">
              <material>
                <mattext texttype="text/plain">Acertado.</mattext>
              </material>
            </response_label>
            <response_label ident="30849">
              <material>
                <mattext texttype="text/plain">Es correcto, pero poco preciso</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">4159</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El problema con la fijación de precios en función de los costes es que resulta muy complicado o imposible en algunas industrias conocer el coste unitario del producto antes de definir su precio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g375bb921837ef1379350ad8802fe029f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>32536,13643,40361</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En relación con la política de precio los Departamentos de Ventas y Marketing&amp;nbsp;tienen como misión:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="32536">
              <material>
                <mattext texttype="text/plain">Lograr maximizar el beneficio a medio y largo plazo.</mattext>
              </material>
            </response_label>
            <response_label ident="13643">
              <material>
                <mattext texttype="text/plain">No sólo marcar el precio sino aumentar el valor percibido por los clientes para poder subir los precios.</mattext>
              </material>
