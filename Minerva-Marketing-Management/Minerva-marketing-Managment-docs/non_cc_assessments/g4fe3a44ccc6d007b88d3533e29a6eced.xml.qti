          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;A la hora de fijar precios van a existir distintas variables, objetivos y estrategias que pueden hacer variar el precio.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="50008">
              <material>
                <mattext texttype="text/plain">Si, existen variables que hay que considerar y tener una estrategia de fijación de precios concreta y estable.</mattext>
              </material>
            </response_label>
            <response_label ident="69037">
              <material>
                <mattext texttype="text/plain">No, en realidad es algo que se puede hacer con rapidez y no tiene mayores implicaciones.</mattext>
              </material>
            </response_label>
            <response_label ident="19477">
              <material>
                <mattext texttype="text/plain">Ninguna de las dos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">50008</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Existen variables como los costes, demanda y competencia, pero también objetivos de ventas y aún más estrategias de posicionamiento entre otras. Todas ellas afectan al precio final.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4f6aeed2e40fa40bcbfd42f5b3ee4e78" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>51190,19699,19584</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando un consumidor evalúa la mayor o menor idoneidad de una oferta, es decir su capacidad para proporcionarle beneficios.&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51190">
              <material>
                <mattext texttype="text/plain">Es algo que no podemos controlar.</mattext>
              </material>
            </response_label>
            <response_label ident="19699">
              <material>
                <mattext texttype="text/html">Al encontrar muchos productos en el lineal el consumidor únicamente presta atención al precio. &amp;nbsp; &amp;nbsp;&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="19584">
              <material>
                <mattext texttype="text/plain">Puede tomar como referencia numerosos atributos del producto o servicio considerado: sus componentes, el envase, la facilidad de uso, las garantías ofrecidas, la forma de pago.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">19584</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">En la toma de decisión del consumidor entran en juego todos los recursos que el marketing puede manejar a la hora de definir el producto.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g77707a570bde76596b14341e025330fa" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
