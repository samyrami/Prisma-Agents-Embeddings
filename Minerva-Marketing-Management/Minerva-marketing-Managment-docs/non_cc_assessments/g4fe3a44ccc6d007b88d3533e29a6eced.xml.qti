          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando hablamos de los límites de la automatización en los procesos que se ceden a los clientes podemos decir.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="67645">
              <material>
                <mattext texttype="text/plain">No existen límites en las capacidades de las personas.</mattext>
              </material>
            </response_label>
            <response_label ident="99134">
              <material>
                <mattext texttype="text/plain">Mientras todo funciona como se prevé por parte de las empresas pero la situación es crítica cada vez que los servicios automatizados no funcionan o el consumidor no consigue co-producir correctamente.</mattext>
              </material>
            </response_label>
            <response_label ident="61135">
              <material>
                <mattext texttype="text/plain">Ninguno.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">99134</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque la situación es crítica cada vez que los servicios automatizados no funcionan o que el consumidor no consigue co-producir correctamente.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="ge69952f0f83f46ff4ee113a310de0507" title="Question">
