    <item ident="ga2055b2e5f05fb6c0a56ff0fb306acb7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>96226,91895,88832</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El beneficio para el consumidor que aportan nuestros productos o servicios se pueden catalogar en tres tipos:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="96226">
              <material>
                <mattext texttype="text/plain">El beneficio puede ser funcional, emocional y expresivo.</mattext>
              </material>
            </response_label>
            <response_label ident="91895">
              <material>
                <mattext texttype="text/plain">Tangibles o intangibles.</mattext>
              </material>
            </response_label>
            <response_label ident="88832">
              <material>
                <mattext texttype="text/plain">Ambos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96226</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque los beneficios que percibe el cliente pueden resumirse en algunas de las tres categorías.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g74d9f1ccef7f432d5c494345b73d70c3" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>93359,17170,77545</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La autoproducción dirigida es …&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="93359">
              <material>
                <mattext texttype="text/plain">Consiste en la realización de tareas suficientemente sencillas para poder ser realizadas por el mismo consumidor o usuario de nuestro producto o servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="17170">
              <material>
                <mattext texttype="text/plain">Produce un valor para la empresa y reemplaza parcialmente el trabajo que hacían los profesionales por la colaboración del cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="77545">
              <material>
                <mattext texttype="text/plain">Ambos</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">77545</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque el consumidor realiza sólo, con la ayuda de una herramienta más o menos “inteligente” un trabajo operativo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9865e43ebd025aba53eef9bdb6200d99" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
