      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando el consumidor compara el precio de dos opciones de comprar distintas o bien de un mismo producto cuyo precio se ha modificado, puede percibir la diferencia existente entre ellos como significativas o no…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="24967">
              <material>
                <mattext texttype="text/plain">Resulta complicado dar una respuesta con evidencia científica.</mattext>
              </material>
            </response_label>
            <response_label ident="85062">
              <material>
                <mattext texttype="text/plain">En realidad, eso no afecta al marketing como tal.</mattext>
              </material>
            </response_label>
            <response_label ident="79730">
              <material>
                <mattext texttype="text/plain">La evidencia empírica y estudiada por la psicología del consumo indica que los consumidores realizan interpretaciones distintas del precio de venta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">79730</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Cada consumidor en función de sus propios valores y experiencia decide asignar un valor diferencial al precio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb64b4aac1219f5b4f49bc3a7b024660e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
