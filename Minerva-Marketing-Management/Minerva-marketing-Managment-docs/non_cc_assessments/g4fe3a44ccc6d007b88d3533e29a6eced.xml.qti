      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuál es el precio percibido?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="62242">
              <material>
                <mattext texttype="text/plain">Es el precio de venta</mattext>
              </material>
            </response_label>
            <response_label ident="80391">
              <material>
                <mattext texttype="text/plain">Es el precio que nos gustaría poner al producto o servicio.</mattext>
              </material>
            </response_label>
            <response_label ident="29898">
              <material>
                <mattext texttype="text/plain">El proceso mediante el cual los consumidores transforman las señales de precio en estructuras cognitivas dotadas de significado</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
