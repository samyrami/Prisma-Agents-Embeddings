            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>91777,78237,76022</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿El objetivo del revenue management es?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="91777">
              <material>
                <mattext texttype="text/plain">El objetivo del revenue management es extraer el máximo posible el precio diferencial de los clientes.</mattext>
              </material>
            </response_label>
            <response_label ident="78237">
              <material>
                <mattext texttype="text/plain">Aumentar la satisfacción del cliente</mattext>
              </material>
            </response_label>
            <response_label ident="76022">
              <material>
                <mattext texttype="text/plain">Ninguno de los anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">91777</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El primer punto es tener claro que una cosa es lo que pagan los clientes y otra lo que estarían dispuestos a pagar. El objetivo del revenue management es extraer el máximo posible de ese excedente</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g7d75695420282e2f54e6f22fc763f76d" title="Question">
