              </material>
            </response_label>
            <response_label ident="31495">
              <material>
                <mattext texttype="text/plain">La probabilidad de que recomienden la compañía en general.</mattext>
              </material>
            </response_label>
            <response_label ident="91655">
              <material>
                <mattext texttype="text/html">&amp;nbsp;Ambos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
