      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Entre los métodos que una empresa utiliza para recoger información se encuentran…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="63033">
              <material>
                <mattext texttype="text/plain">Los métodos clásicos de recuperación de la información (encuestas, cuestionarios a rellenar de varias formas, focus groups)</mattext>
              </material>
            </response_label>
            <response_label ident="84680">
              <material>
                <mattext texttype="text/plain">Por otro lado, Internet permite extraer información del consumidor tanto de manera determinística como probabilística.</mattext>
              </material>
            </response_label>
            <response_label ident="8186">
              <material>
                <mattext texttype="text/plain">Ambas</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8186</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La respuesta es correcta porque son dos de los métodos en que una empresa puede obtener información de sus consumidores, aunque no las únicas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gf4c2b3fa0e0dd7d9b6e07b887cb49766" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
