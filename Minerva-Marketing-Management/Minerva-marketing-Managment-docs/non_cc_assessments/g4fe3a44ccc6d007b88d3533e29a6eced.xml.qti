          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El objetivo es ser capaces de transmitir al cliente el valor de producto con todas las herramientas del marketing operativo para subir la percepción de valor.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g50c3e663ea5bfba2bb49f38cd8889ff4" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>76477,49434,64473</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La reducción de precios es probablemente la manera más rápida de alcanzar los objetivos de ventas, pero:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="76477">
              <material>
                <mattext texttype="text/plain">Tenemos que compararnos con la competencia.</mattext>
              </material>
            </response_label>
            <response_label ident="49434">
              <material>
                <mattext texttype="text/plain">Es una decisión equivocada desde el punto de vista de la rentabilidad.</mattext>
              </material>
            </response_label>
            <response_label ident="64473">
              <material>
                <mattext texttype="text/plain">Ambas son falsas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49434</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es una decisión que puede llegar a lograr los objetivos de ventas pero que va a erosionar la rentabilidad del producto o servicio a medio plazo, poniendo en riesgo la viabilidad del mismo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gba53fe359d00766d75eb66cd292ae71f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>49366,77509,41935</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Existe alguna ocasión en donde la bajada de precio como arma competitiva va a poder ser utilizada?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="49366">
              <material>
                <mattext texttype="text/plain">Si, cuando tengamos una estructura de costes más eficiente y que por lo tanto suponga que nuestros competidores no lo puedan igualar.</mattext>
              </material>
            </response_label>
            <response_label ident="77509">
              <material>
                <mattext texttype="text/plain">No, el precio nunca es una estrategia que se pueda utilizar.</mattext>
              </material>
            </response_label>
            <response_label ident="41935">
              <material>
                <mattext texttype="text/plain">Ninguna de las dos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49366</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Únicamente en aquellas contadas ocasiones en donde podemos estar seguros de que la competencia no va a poder igualar nuestro precio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g0812eddcab1223e083b0dd0568afda0b" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
