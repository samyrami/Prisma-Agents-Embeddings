            <response_label ident="78935">
              <material>
                <mattext texttype="text/plain">Es poner en común la información de los clientes recabada a través de los distintos canales (tiendas físicas, página web, app móvil o redes sociales).</mattext>
              </material>
            </response_label>
            <response_label ident="22513">
              <material>
                <mattext texttype="text/plain">Utilizar herramientas de gestión analítica que sean capaces de identificar sus gustos y necesidades independientemente del canal en el que se encuentre el cliente.</mattext>
              </material>
            </response_label>
            <response_label ident="96541">
              <material>
                <mattext texttype="text/plain">Ambas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">96541</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Podemos tratar de controlar muchas variables mediante algoritmos pero no siempre sabremos exactamente las características que marcan la diferencia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g5b85bf9dab894810831b82971659b167" title="Question">
      <itemmetadata>
        <qtimetadata>
