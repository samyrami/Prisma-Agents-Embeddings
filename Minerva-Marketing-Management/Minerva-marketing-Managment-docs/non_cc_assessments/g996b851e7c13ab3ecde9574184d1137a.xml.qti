          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El canal que utiliza el marketing mix de un producto para llegar al consumidor…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95471">
              <material>
                <mattext texttype="text/plain">No afecta a la percepción del producto por parte del consumidor.</mattext>
              </material>
            </response_label>
            <response_label ident="83834">
              <material>
                <mattext texttype="text/plain">Incluye en la consideración que el consumidor tiene del producto.</mattext>
              </material>
            </response_label>
            <response_label ident="58342">
              <material>
                <mattext texttype="text/plain">Ambas</mattext>
              </material>
            </response_label>
          </render_choice>
