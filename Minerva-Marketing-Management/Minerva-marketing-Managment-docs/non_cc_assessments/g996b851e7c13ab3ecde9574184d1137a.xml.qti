    <item ident="gbb846367dc3d582bc0d58ae83e0f1c5e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>82503,38905,45876</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Las funciones de un canal de distribución serían:&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="82503">
              <material>
                <mattext texttype="text/plain">La función principal del canal de distribución es mostrar la proposición de valor frente a la competencia.</mattext>
              </material>
            </response_label>
            <response_label ident="38905">
              <material>
                <mattext texttype="text/plain">Reunir información y distribuir información de inteligencia acerca del consumidor y del entorno necesaria para planificar, hacer promoción, encontrar potenciales compradores y adecuar la oferta.</mattext>
              </material>
            </response_label>
            <response_label ident="45876">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">38905</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La función principal de la distribución es acercar el producto o servicio al consumidor y recoger la información necesaria para poder adaptar la oferta.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g20bbff2bdbd872fd4d08b660e034bd10" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
