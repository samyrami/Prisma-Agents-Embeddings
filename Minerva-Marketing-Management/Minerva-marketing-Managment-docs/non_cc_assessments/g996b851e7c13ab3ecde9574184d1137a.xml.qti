        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El modelo de distribución tradicional frente al digital supone que:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="79229">
              <material>
                <mattext texttype="text/plain">Potencialmente existe la posibilidad de captar clientes fuera del área de influencia y por lo tanto esa experiencia de compra se deslocaliza.</mattext>
              </material>
            </response_label>
            <response_label ident="12205">
              <material>
                <mattext texttype="text/plain">El modelo tradicional de distribución tiende a desaparecer.</mattext>
              </material>
            </response_label>
            <response_label ident="3923">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">79229</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La deslocalización del acto comercial significa que el número de clientes potenciales aumenta pero también existen unos procesos logísticos que hay que acometer convenientemente para no penalizar la experiencia de compra.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
