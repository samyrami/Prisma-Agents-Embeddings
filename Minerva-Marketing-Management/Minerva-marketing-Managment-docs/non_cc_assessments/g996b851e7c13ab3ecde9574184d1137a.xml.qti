              </material>
            </response_label>
            <response_label ident="66216">
              <material>
                <mattext texttype="text/plain">No es una información que la empresa pueda controlar.</mattext>
              </material>
            </response_label>
            <response_label ident="34605">
              <material>
                <mattext texttype="text/plain">Ninguna</mattext>
              </material>
            </response_label>
          </render_choice>
