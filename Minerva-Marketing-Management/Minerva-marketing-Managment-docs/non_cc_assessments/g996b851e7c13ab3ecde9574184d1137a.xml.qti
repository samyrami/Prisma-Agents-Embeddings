        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="86101">
              <material>
                <mattext texttype="text/plain">Que cuanto menos actores haya en la entrega de valor al cliente la atención será más inmediata y en consecuencia habrá más y mejores ventas.</mattext>
              </material>
            </response_label>
            <response_label ident="48713">
              <material>
                <mattext texttype="text/plain">El uso de la tecnología es imprescindible, es lo que nos ayuda a desintermediar o eliminar intermediarios.</mattext>
              </material>
            </response_label>
            <response_label ident="73454">
              <material>
                <mattext texttype="text/plain">Ambas son ciertas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">73454</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Eliminar intermediarios gracias al uso de la tecnología es lo que se conoce como desintermediar.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
