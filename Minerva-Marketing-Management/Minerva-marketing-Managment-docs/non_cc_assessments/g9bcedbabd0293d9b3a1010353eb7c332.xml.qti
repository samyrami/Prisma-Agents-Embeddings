      <presentation>
        <material>
          <mattext texttype="text/html">&#xBF;Por qu&#xE9; las marcas deben dejar de hablar bien de s&#xED; mismas?</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="68340093-1f1b-4fb6-bcf8-ee895097c5ed">
