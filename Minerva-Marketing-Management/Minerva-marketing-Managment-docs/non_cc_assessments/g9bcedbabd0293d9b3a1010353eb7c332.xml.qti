      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&#xBF;Por qu&#xE9; las redes sociales desaf&#xED;an al marketing tradicional?</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="25413bcb-e3eb-4bff-9e8f-5a9e2204803d">
              <material>
                <mattext texttype="text/html">Porque eliminan la publicidad</mattext>
              </material>
            </response_label>
            <response_label ident="bc25c063-57c7-4dbb-a492-57f38b1f1ad7">
              <material>
                <mattext texttype="text/html">Porque reducen el uso de Internet</mattext>
              </material>
            </response_label>
            <response_label ident="5991b5ab-4d78-4cf9-afe7-f7358efc56a0">
              <material>
                <mattext texttype="text/html">Porque cambian c&#xF3;mo los consumidores se informan y deciden</mattext>
