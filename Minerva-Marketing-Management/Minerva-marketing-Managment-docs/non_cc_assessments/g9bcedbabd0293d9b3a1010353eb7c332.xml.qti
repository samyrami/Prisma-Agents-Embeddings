      <presentation>
        <material>
          <mattext texttype="text/html">Seg&#xFA;n el texto, &#xBF;por qu&#xE9; estas influencers son valiosas para las marcas?</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="fd10cc44-d6b2-47e7-86cc-91d206e7695d">
              <material>
                <mattext texttype="text/html">Porque sustituyen al marketing tradicional</mattext>
              </material>
            </response_label>
            <response_label ident="c07d1f05-73ac-47a3-8c04-24586c65c89c">
              <material>
                <mattext texttype="text/html">Porque garantizan ventas inmediatas</mattext>
              </material>
            </response_label>
            <response_label ident="b6778413-41b6-4a86-9c21-d11895cd7e7a">
              <material>
                <mattext texttype="text/html">Porque son cre&#xED;bles y menos costosas</mattext>
              </material>
            </response_label>
            <response_label ident="e8811781-bb01-4254-ab5c-df9b369d1edc">
              <material>
                <mattext texttype="text/html">Porque controlan los medios</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">b6778413-41b6-4a86-9c21-d11895cd7e7a</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
