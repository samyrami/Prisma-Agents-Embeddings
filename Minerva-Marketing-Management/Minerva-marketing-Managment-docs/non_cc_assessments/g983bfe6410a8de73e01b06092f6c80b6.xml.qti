      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En relación con el modelo de compra que elijamos para nuestras campañas:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="4969">
              <material>
                <mattext texttype="text/plain">En función del objetivo que nos marquemos en nuestra campaña podremos aplicar un modelo u otro.</mattext>
              </material>
            </response_label>
            <response_label ident="74395">
              <material>
                <mattext texttype="text/plain">Para una campaña que busque notoriedad de marca, deberías inclinarte por un esquema del tipo CPM si por el contrario quiere además un objetivo de ventas, deberías ir a modelos más a CPC, CPL o CPA.</mattext>
              </material>
            </response_label>
            <response_label ident="9794">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9794</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El modelo de compra está muy relacionado con el objetivo que persigue la campaña.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g20c8b5cce07168e8b10e68b40bac1259" title="Question">
