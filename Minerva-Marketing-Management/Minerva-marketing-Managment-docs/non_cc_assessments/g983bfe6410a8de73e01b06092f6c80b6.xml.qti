        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuándo hablamos de optimizar una campaña de Compra Programática entendemos?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="31925">
              <material>
                <mattext texttype="text/plain">Revisar que las impresiones son las fijadas en el briefing.</mattext>
              </material>
            </response_label>
            <response_label ident="58187">
              <material>
                <mattext texttype="text/plain">Una vez lanzada la campaña podemos ir analizando para ir optimizando y conocer qué medio y soporte tiene el mejor KPI de medición. De esta manera podemos modificar la campaña para lograr un mejor resultado final.</mattext>
              </material>
            </response_label>
            <response_label ident="2650">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">58187</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Optimizar consiste en seguir los kpi´s que permiten encontrar el mejor formato y medio para alcanzar de la manera más satisfactoria los objetivos.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g17ec65ecac9014d022dfb18c45b10ae8" title="Question">
