            <varequal respident="response1">707</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El trading desk está enfocado hacia la compra inteligente de audiencias mediante tecnologías de optimización en múltiples plataformas (ad exchanges, networks, DSPs, soportes) de manera tal, que comprará aquella impresión de manera más eficiente para los objetivos de sus clientes/anunciantes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9f43121ae057d340546c254b4b280e09" title="Question">
      <itemmetadata>
        <qtimetadata>
