          <render_choice>
            <response_label ident="68833">
              <material>
                <mattext texttype="text/plain">Formato, ubicación, peso y fees externos.</mattext>
              </material>
            </response_label>
            <response_label ident="58946">
              <material>
                <mattext texttype="text/plain">Eso más el soporte o Publisher.</mattext>
              </material>
            </response_label>
            <response_label ident="38818">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">38818</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El medio más las características propias de la creatividad configuran el precio CPM que vamos a pagar en nuestra campaña.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc868b8d2ede9ed4ff27bc33a9691d358" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>71348,95092,82893</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿La forma de exposición de los anuncios en los soportes que denominamos ROS hace referencia a?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="71348">
              <material>
                <mattext texttype="text/plain">Run on site (ROS), las impresiones rotan por las páginas del portal y en todos los horarios.</mattext>
              </material>
            </response_label>
            <response_label ident="95092">
              <material>
                <mattext texttype="text/plain">Las impresiones rotan por las páginas del portal y se pueden seleccionar horas por ejemplos que coincidan con los horarios del call center, o bien cuando creemos que nuestro target se encuentra en un horario determinado.</mattext>
              </material>
            </response_label>
            <response_label ident="82893">
              <material>
                <mattext texttype="text/plain">Ambas son correctas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">82893</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Es un formato común de compra a CPM en los principales medios y grupos editoriales, tiene poca inteligencia y la migración a Compra Programática en estos modelos de compra es imparable.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gac44cbf8f30bf35e180d7f613a792588" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
