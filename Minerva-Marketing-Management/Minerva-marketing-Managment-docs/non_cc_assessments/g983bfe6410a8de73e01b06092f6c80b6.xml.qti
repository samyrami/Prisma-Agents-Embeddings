            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">95167</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Un DSP tiene una interfaz única que permite pujar, optimizar, y obtener informes para poder optimizar las campañas.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g68d5b58ecf1715504c10e2f4fea22019" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>79414,49265,93088</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuáles son las diferencias entre los diferentes DSP's?&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="79414">
              <material>
                <mattext texttype="text/plain">No existen diferencias más allá del diferente propietario y desarrollador.</mattext>
              </material>
            </response_label>
            <response_label ident="49265">
              <material>
                <mattext texttype="text/plain">En función del número de fuentes de inventario a las que tienen acceso automatizado, la tipología y la procedencia de datos que integran y la eficacia de su algoritmo de optimización y su escala internacional.</mattext>
              </material>
            </response_label>
            <response_label ident="93088">
              <material>
                <mattext texttype="text/plain">Ambas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">49265</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Existen diferencias entre los distintos DSP´s y cada uno tiene unas características específicas que los hacen más adecuados para unos tipos u otros de inventario o soporte.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gd964d95b88902d9224c6f9b5a1710582" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
