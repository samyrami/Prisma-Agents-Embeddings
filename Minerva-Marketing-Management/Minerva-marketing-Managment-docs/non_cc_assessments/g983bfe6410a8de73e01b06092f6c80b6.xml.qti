                <mattext texttype="text/plain">No es parte de la compra programática.</mattext>
              </material>
            </response_label>
            <response_label ident="31558">
              <material>
                <mattext texttype="text/plain">Es el dispositivo que permite servir impresiones.</mattext>
              </material>
            </response_label>
            <response_label ident="707">
              <material>
                <mattext texttype="text/plain">Es el equipo técnico de personas que optimizan la compra programática de sus distintos anunciantes conectando con múltiples DSPs.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
