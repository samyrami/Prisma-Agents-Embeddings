          <render_choice>
            <response_label ident="12677">
              <material>
                <mattext texttype="text/plain">Un DSP es una tecnología de puja que permite a anunciantes y/o agencias de medios comprar inventario en diferentes ad exchanges.</mattext>
              </material>
            </response_label>
            <response_label ident="78802">
              <material>
                <mattext texttype="text/plain">Los DSPs también conocidos como bidders pujan por el inventario utilizando datos de la audiencia, de forma que la compra se hace impresión a impresión.</mattext>
              </material>
            </response_label>
            <response_label ident="95167">
              <material>
                <mattext texttype="text/plain">Ambos.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
