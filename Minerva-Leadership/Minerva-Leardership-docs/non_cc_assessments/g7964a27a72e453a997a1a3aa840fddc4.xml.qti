      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria madura:&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="a515f06f-99a2-410a-8b1a-946c705d0b63">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE, GRACIAS A la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="6ee8f929-c10c-49ae-8ca9-36cfd0aec863">
              <material>
                <mattext texttype="text/html">La competencia internacional AUMENTA, GRACIAS A la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="ec84ab00-48f3-401d-be7c-5f0359676efb">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE, A PESAR DE la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="b9c181e3-eff1-462a-833c-9289caca494d">
              <material>
                <mattext texttype="text/html">La competencia internacional DISMINUYE E, A PESAR DE la madurez tecnol&#xF3;gica y a la estandarizaci&#xF3;n del producto</mattext>
              </material>
            </response_label>
            <response_label ident="f208f27d-152c-4c13-87e7-ef879e433916">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
