      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Una estrategia para competir en mercados internacionales&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="9134c3dc-4be8-4afd-949b-dfe061810a8e">
              <material>
                <mattext texttype="text/html">Puede ser reversible con facilidad, porque suele requerir poca inversi&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="7dd3992a-86d4-484f-b451-938de7a08bc1">
              <material>
                <mattext texttype="text/html">Puede ser reversible con facilidad, porque normalmente requiere invertir muchos recursos</mattext>
              </material>
            </response_label>
            <response_label ident="aa281d5a-388b-4040-ba5e-23daec19fe32">
              <material>
                <mattext texttype="text/html">No suele ser reversible con facilidad, porque suele requerir poca inversi&#xF3;n y habr&#xE1; surgido mucha competencia</mattext>
              </material>
            </response_label>
            <response_label ident="3bec96ed-9775-4a20-a3ec-64fb998a4c0a">
              <material>
                <mattext texttype="text/html">No suele ser reversible con facilidad, porque normalmente requiere invertir muchos recursos</mattext>
              </material>
            </response_label>
            <response_label ident="37d959f5-9978-4fd5-aa4e-f066ee692703">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
