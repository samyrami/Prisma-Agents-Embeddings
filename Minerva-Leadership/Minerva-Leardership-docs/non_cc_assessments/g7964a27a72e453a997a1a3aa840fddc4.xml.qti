        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">0378b542-6612-4cfe-a244-2ba9fed0e42b</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Uno de los factores que inciden en el deterioro del atractivo de una industria es, precisamente, el aumento de la competencia internacional, ya que, a menudo, viene acompa&#xF1;ada con la estandarizaci&#xF3;n del producto y la disminuci&#xF3;n de m&#xE1;rgenes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
