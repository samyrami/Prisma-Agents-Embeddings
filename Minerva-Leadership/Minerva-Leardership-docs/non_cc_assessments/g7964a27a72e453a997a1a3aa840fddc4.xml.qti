      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La diversificaci&#xF3;n conglomerada se basa:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5c293c46-25d5-4780-96bb-761372b2c105">
              <material>
                <mattext texttype="text/html">En productos nuevos que tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="55fb9e1c-6116-4c0b-9eec-a685926646d8">
              <material>
                <mattext texttype="text/html">En productos nuevos que no tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que no tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="9e4cac10-0fef-4197-bb8e-7f6ab1d914a4">
              <material>
                <mattext texttype="text/html">En productos nuevos que tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que no tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="6a86bbff-6b37-49c0-9888-773311b802d8">
              <material>
                <mattext texttype="text/html">En productos nuevos que no tienen relaci&#xF3;n con los productos actuales de la empresa y mercados nuevos que tienen relaci&#xF3;n con los mercados actuales de la empresa</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">55fb9e1c-6116-4c0b-9eec-a685926646d8</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Este tipo de diversificaci&#xF3;n es el m&#xE1;s agresivo, ya que la empresa introduce nuevos productos en mercados totalmente nuevos para ella.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
