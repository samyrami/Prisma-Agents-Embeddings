        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6ee8f929-c10c-49ae-8ca9-36cfd0aec863</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La estandarizaci&#xF3;n del producto y la madurez tecnol&#xF3;gica llevan a un incremento de la competencia internacional.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
