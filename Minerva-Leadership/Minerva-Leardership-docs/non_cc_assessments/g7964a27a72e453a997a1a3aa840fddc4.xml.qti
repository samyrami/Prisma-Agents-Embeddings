    <item ident="d2bd46afae9ef3159b0540c1cef376d8" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>48d69b8c-9fc5-41f2-987f-18e6d7177cd1,4ef43876-8811-4907-9d78-4d547f1e3fab,c9c47887-4f3a-4708-bd7a-36d42971445b</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>5e2e8193a5ed3d0144da8dbcf4265111</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El posicionamiento estrat&#xE9;gico:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="48d69b8c-9fc5-41f2-987f-18e6d7177cd1">
              <material>
                <mattext texttype="text/html">Debe de ser el mismo en todos los pa&#xED;ses donde se comercializa el producto, por coherencia de la estrategia, y adem&#xE1;s debe de ser igual al del mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
            <response_label ident="4ef43876-8811-4907-9d78-4d547f1e3fab">
              <material>
                <mattext texttype="text/html">Debe de ser el mismo en todos los pa&#xED;ses donde se comercializa el producto, por coherencia de la estrategia, pero puede diferir del mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
            <response_label ident="c9c47887-4f3a-4708-bd7a-36d42971445b">
              <material>
                <mattext texttype="text/html">No necesariamente debe de ser el mismo en los diferentes pa&#xED;ses donde se comercializa el producto, ni tiene por qu&#xE9; coincidir con el mercado dom&#xE9;stico</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">c9c47887-4f3a-4708-bd7a-36d42971445b</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El posicionamiento estrat&#xE9;gico debe desarrollarse para cada uno de los pa&#xED;ses, y dentro de ellos por cada uno de los segmentos a los que se dirigir&#xE1; el producto. Por tanto, no tiene por qu&#xE9; ser el mismo en todos los pa&#xED;ses, ni coincidir con el del mercado dom&#xE9;stico.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="9b6937cf6c6628912b38d7d4664383ed" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>a9258cb3-ce95-48a3-852a-47c2932447ef,28c168b8-0a2b-4673-8802-ccadd7bc3e6b,56b0c583-51e0-4f41-978e-ff7532dea533,2f19ae35-0580-4deb-9832-b6a9455b843a</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>54c8b3b047a503688f0378fab93b7e91</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La estrategia de internacionalizaci&#xF3;n:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="a9258cb3-ce95-48a3-852a-47c2932447ef">
              <material>
                <mattext texttype="text/html">Requerir&#xE1; contar con un producto de calidad &#xFA;nicamente cuando el mercado de ese pa&#xED;s est&#xE1; demandando un producto de calidad</mattext>
              </material>
            </response_label>
            <response_label ident="28c168b8-0a2b-4673-8802-ccadd7bc3e6b">
              <material>
                <mattext texttype="text/html">Es independiente con el hecho de contar con un producto de calidad, tiene m&#xE1;s que ver con variables como el conocimiento del mercado o el acceso a canales de distribuci&#xF3;n donde exista demanda del producto</mattext>
              </material>
            </response_label>
            <response_label ident="56b0c583-51e0-4f41-978e-ff7532dea533">
              <material>
                <mattext texttype="text/html">Tiene como primer requisito contar con un producto de calidad</mattext>
              </material>
            </response_label>
            <response_label ident="2f19ae35-0580-4deb-9832-b6a9455b843a">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">56b0c583-51e0-4f41-978e-ff7532dea533</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El primer requisito para tener &#xE9;xito en una estrategia de internacionalizaci&#xF3;n es contar con un producto de calidad, y a partir de ah&#xED; decidir el binomio producto-mercado m&#xE1;s adecuado. Intentar esta estrategia sin un producto de calidad, aunque pensemos que el mercado no lo va a demandar, ser&#xED;a un grave error.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="d35b4cb585a65157795738286f7357a9" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>24187300-7762-4f12-be66-2f64935e67d2,9cdec5f4-3d54-4118-90af-13e2583a0272,23ed6db3-c18d-4ea4-b896-465626ba3939,6148fb2f-bd5b-4f3c-8f06-eaa414ee77c3</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>343491e382e0c35bcdb2f6006ef5c308</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria en declive:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="24187300-7762-4f12-be66-2f64935e67d2">
              <material>
                <mattext texttype="text/html">Cuanto MAYORES sean las barreras de SALIDA, m&#xE1;s DIF&#xCD;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="9cdec5f4-3d54-4118-90af-13e2583a0272">
              <material>
                <mattext texttype="text/html">Cuanto MENORES sean las barreras de SALIDA, m&#xE1;s DIF&#xCD;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="23ed6db3-c18d-4ea4-b896-465626ba3939">
              <material>
                <mattext texttype="text/html">Cuanto MAYORES sean las barreras de ENTRADA, m&#xE1;s F&#xC1;CIL ser&#xE1; la reducci&#xF3;n de la capacidad</mattext>
              </material>
            </response_label>
            <response_label ident="6148fb2f-bd5b-4f3c-8f06-eaa414ee77c3">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">24187300-7762-4f12-be66-2f64935e67d2</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las grandes inversiones realizadas y la dificultad de recuperar las mismas, har&#xE1; que muchas empresas decidan continuar produciendo, a pesar de la reducci&#xF3;n de la demanda, generando un incremento muy importante de la competencia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="415ac73177c02980aac45c166e80215e" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>5b55693e-699c-43ca-ad56-b88b229561e4,51221e3b-2d01-4f7e-9678-11942eb4f8ea,8147c033-da38-4acd-81de-924bf185dfe0,eb0e7b79-f3f0-4ff2-9c81-33668cf2dfc7</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>fe6271adec4cb5c4ab3e8f42f1bb0ff0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Cuando el producto est&#xE1; estandarizado:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5b55693e-699c-43ca-ad56-b88b229561e4">
              <material>
                <mattext texttype="text/html">No es posible desarrollar una estrategia de diferenciaci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="51221e3b-2d01-4f7e-9678-11942eb4f8ea">
              <material>
                <mattext texttype="text/html">Resulta m&#xE1;s f&#xE1;cil desarrollar una estrategia de diferenciaci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="8147c033-da38-4acd-81de-924bf185dfe0">
              <material>
                <mattext texttype="text/html">Es m&#xE1;s complicado desarrollar una estrategia de diferenciaci&#xF3;n, pero siempre es posible generarla</mattext>
              </material>
            </response_label>
            <response_label ident="eb0e7b79-f3f0-4ff2-9c81-33668cf2dfc7">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">8147c033-da38-4acd-81de-924bf185dfe0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&amp;nbsp;A pesar de que el producto est&#xE9; muy estandarizado, siempre es posible introducir determinadas mejoras que faciliten el desarrollo de una estrategia de diferenciaci&#xF3;n. Esas mejoras pueden darse en el servicio, en la calidad o en la distribuci&#xF3;n.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
