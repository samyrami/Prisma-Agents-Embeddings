      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria madura:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ff3d6082-e354-4a7f-89cf-4c948e9f3400">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional AUMENTA el atractivo de la industria porque AUMENTA los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="2fdf2b02-d189-4947-b458-d6f1b354dfd5">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional AUMENTA el atractivo de la industria porque DISMINUYE los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="32dd3ad6-81e0-4ef0-b8f3-db0f1e6d439f">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional DISMINUYE el atractivo de la industria porque AUMENTA los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="0378b542-6612-4cfe-a244-2ba9fed0e42b">
              <material>
                <mattext texttype="text/html">El aumento de la competencia internacional DISMINUYE el atractivo de la industria porque DISMINUYE los m&#xE1;rgenes al estandarizar el producto</mattext>
              </material>
            </response_label>
            <response_label ident="ca34d286-3a07-4da3-8eea-a86d31cf076d">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
