    <item ident="ffa7252f3f2c0d5903dfdce7484830ac" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>1a01d8d4-614b-4473-96b6-2b1353de9683,76cee378-7f42-4ce3-9b48-ae50299143e5,87f839e3-669d-4037-934e-5d1665ab3734</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>e4dfc72a7511d5145d9f17c5756dc597</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&#xBF;Cu&#xE1;ndo favorece la estrategia de enfoque la existencia de un nicho de mercado?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="1a01d8d4-614b-4473-96b6-2b1353de9683">
              <material>
                <mattext texttype="text/html">Cuando es manejable (nicho de mercado peque&#xF1;o)</mattext>
              </material>
            </response_label>
            <response_label ident="76cee378-7f42-4ce3-9b48-ae50299143e5">
              <material>
                <mattext texttype="text/html">Cuando es suficientemente grande</mattext>
              </material>
            </response_label>
            <response_label ident="87f839e3-669d-4037-934e-5d1665ab3734">
              <material>
                <mattext texttype="text/html">Si hay un nicho identificable, siempre es interesante una estrategia de enfoque. El tama&#xF1;o del nicho no favorece o dificulta la posibilidad de desarrollar una estrategia de enfoque</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">76cee378-7f42-4ce3-9b48-ae50299143e5</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El nicho de mercado debe ser lo suficientemente grande como para que sea rentable. Por tanto, el tama&#xF1;o del nicho influye, y ser&#xE1; m&#xE1;s f&#xE1;cil desarrollar la estrategia de enfoque si el nicho es grande.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="35b281870884c0a00040fac821e2e161" title="Question">
