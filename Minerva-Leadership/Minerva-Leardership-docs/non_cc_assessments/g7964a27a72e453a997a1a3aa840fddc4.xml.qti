      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En una industria emergente:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="83d581c9-0ed5-44d8-99ad-1273b0066465">
              <material>
                <mattext texttype="text/html">Las empresas poseen una sola opci&#xF3;n estrat&#xE9;gica</mattext>
              </material>
            </response_label>
            <response_label ident="76c9af10-573d-45fb-a7c3-4cf437af4fad">
              <material>
                <mattext texttype="text/html">Las empresas poseen siempre un muy reducido n&#xFA;mero de opciones estrat&#xE9;gicas, aunque no necesariamente una &#xFA;nica opci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="b15a051a-12c2-49cd-bda5-88991f0d9a2b">
              <material>
                <mattext texttype="text/html">Las empresas suelen disponer de un n&#xFA;mero elevado de opciones estrat&#xE9;gicas</mattext>
              </material>
            </response_label>
            <response_label ident="f080bc94-f715-4f56-bc89-a5bb9d51d489">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">b15a051a-12c2-49cd-bda5-88991f0d9a2b</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En una industria emergente, la incertidumbre estrat&#xE9;gica hace que las empresas disponen, generalmente, de un n&#xFA;mero elevado de opciones estrat&#xE9;gicas, que se revelar&#xE1;n adecuadas o no a medida que la industria se consolide.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
