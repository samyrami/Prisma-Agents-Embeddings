      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Los objetivos estrat&#xE9;gicos deben definirse&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="5b7c06c7-8a56-4fb1-82a7-ddf0607221f0">
              <material>
                <mattext texttype="text/html">De arriba abajo, pues hay que asegurar la coherencia.</mattext>
              </material>
            </response_label>
            <response_label ident="bfe145d3-b654-4715-95d8-5cb0342b34a2">
              <material>
                <mattext texttype="text/html">De abajo a arriba, ya que las unidades inferiores son las que mejor conocen el negocio.</mattext>
              </material>
            </response_label>
            <response_label ident="8be72e4d-6c02-43ee-a16e-a8440c07dc2c">
              <material>
                <mattext texttype="text/html">Ninguna es correcta.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5b7c06c7-8a56-4fb1-82a7-ddf0607221f0</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Los objetivos estrat&#xE9;gicos deben definirse de arriba a abajo, sirviendo de gu&#xED;a a los niveles inferiores y asegurando la coherencia entre todas las unidades.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
