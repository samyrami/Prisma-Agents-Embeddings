      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La creaci&#xF3;n de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="055d6b88-8712-494b-9f08-9d089aede8ec">
              <material>
                <mattext texttype="text/html">Debe involucrar a los directivos, aunque basta con una aceptaci&#xF3;n pasiva de la estrategia impuesta por la compa&#xF1;&#xED;a</mattext>
              </material>
            </response_label>
            <response_label ident="d02fffb0-b022-4a38-9c19-103110f8bead">
              <material>
                <mattext texttype="text/html">Debe involucrar a los directivos de forma proactiva</mattext>
              </material>
            </response_label>
            <response_label ident="cc021573-4090-490a-adf6-a8df8aca2dd2">
              <material>
                <mattext texttype="text/html">Ninguna es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">d02fffb0-b022-4a38-9c19-103110f8bead</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La creaci&#xF3;n de una estrategia de &#xE9;xito deber&#xED;a ser una tarea prioritaria en cada organizaci&#xF3;n. Los directivos de la empresa deben ser proactivos al modelar la forma en que se desarrollar&#xE1;n los negocios de la compa&#xF1;&#xED;a.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="0b7c52569868d6c34b015bd909694295" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
