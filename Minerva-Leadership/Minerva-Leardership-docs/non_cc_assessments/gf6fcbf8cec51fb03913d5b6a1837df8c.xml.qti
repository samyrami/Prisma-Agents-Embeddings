    <item ident="1e2b12585e195f091db6dc886d879782" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>6dc8277a-30b9-433d-9a63-a341d0631451,fb30ba53-e7bc-47df-8a58-03ffcf989614,814c88a7-14b1-4c2a-86dc-46360f1a6860,80a8a933-7fc5-4b5f-9ef3-5fb117cf1fe7</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>817ab4a87d405c42933c77bd12fe3e71</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La visi&#xF3;n estrat&#xE9;gica de la empresa.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6dc8277a-30b9-433d-9a63-a341d0631451">
              <material>
                <mattext texttype="text/html">Deben conocerla todos los integrantes de la empresa.</mattext>
              </material>
            </response_label>
            <response_label ident="fb30ba53-e7bc-47df-8a58-03ffcf989614">
              <material>
                <mattext texttype="text/html">Basta con que la conozcan los directivos intermedios.</mattext>
              </material>
            </response_label>
            <response_label ident="814c88a7-14b1-4c2a-86dc-46360f1a6860">
              <material>
                <mattext texttype="text/html">Basta con que la conozcan los directivos de primer nivel.</mattext>
              </material>
            </response_label>
            <response_label ident="80a8a933-7fc5-4b5f-9ef3-5fb117cf1fe7">
              <material>
                <mattext texttype="text/html">Es un elemento b&#xE1;sico de la estrategia, y por tanto debe conocerla &#xFA;nicamente el CEO de la compa&#xF1;&#xED;a.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6dc8277a-30b9-433d-9a63-a341d0631451</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La visi&#xF3;n estrat&#xE9;gica debe ser conocida por todos los integrantes de la empresa, ya que las personas que la componen deben conocer hacia d&#xF3;nde se dirige, facilitando su compromiso con la compa&#xF1;&#xED;a y reforzando el orgullo de sentirse parte de ella.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="0086226173ae4ec5864bacc1f4a7fa9c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>95d0047f-3834-49de-ba3f-0cbb2e242143,582f76fb-3d8c-4d3e-b52c-3781cc7dc035,2cb43925-354e-42d7-a0c7-c5b7a673a104,b676db3b-6364-4fe4-b3ce-23320e9c46ac</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>4ffb225eae14c53000a875e90a3a82e1</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En la creaci&#xF3;n de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="95d0047f-3834-49de-ba3f-0cbb2e242143">
              <material>
                <mattext texttype="text/html">Debe opinar y participar toda la compa&#xF1;&#xED;a.</mattext>
              </material>
            </response_label>
            <response_label ident="582f76fb-3d8c-4d3e-b52c-3781cc7dc035">
              <material>
                <mattext texttype="text/html">S&#xF3;lo opinan y se involucran los directivos.</mattext>
              </material>
            </response_label>
            <response_label ident="2cb43925-354e-42d7-a0c7-c5b7a673a104">
              <material>
                <mattext texttype="text/html">Los directivos definen la estrategia, y la estrategia es ajena al resto de la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="b676db3b-6364-4fe4-b3ce-23320e9c46ac">
              <material>
                <mattext texttype="text/html">Los directivos definen la estrategia, y deben involucrar al resto de la compa&#xF1;&#xED;a en su ejecuci&#xF3;n.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">b676db3b-6364-4fe4-b3ce-23320e9c46ac</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La creaci&#xF3;n de una estrategia, junto con su ejecuci&#xF3;n son funciones directivas esenciales. Corresponde por tanto a los directivos definir la estrategia e involucrar a todos los integrantes de la empresa para que su ejecuci&#xF3;n se ajuste a la definici&#xF3;n realizada.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="7716ce8dc42141cd3c3717e535d06eb4" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>36fb83a9-8956-4f66-a43d-0441c508552f,a6aa3ea1-e011-466e-905e-0c15cc7069ce,0be2b497-029a-496c-9415-94b8aa69c326</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>f39e2c092f070cd743e97693d04483d3</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En el proceso de creaci&#xF3;n de una estrategia&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="36fb83a9-8956-4f66-a43d-0441c508552f">
              <material>
                <mattext texttype="text/html">Se definen los negocios en los que est&#xE1; compitiendo una compa&#xF1;&#xED;a.</mattext>
              </material>
            </response_label>
            <response_label ident="a6aa3ea1-e011-466e-905e-0c15cc7069ce">
              <material>
                <mattext texttype="text/html">Se definen los negocios en los que competir&#xE1; la compa&#xF1;&#xED;a en un futuro.</mattext>
              </material>
            </response_label>
            <response_label ident="0be2b497-029a-496c-9415-94b8aa69c326">
              <material>
                <mattext texttype="text/html">No es necesario definir los negocios en los que compite la compa&#xF1;&#xED;a, o competir&#xE1; en un futuro.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">a6aa3ea1-e011-466e-905e-0c15cc7069ce</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">En el proceso de creaci&#xF3;n de una estrategia se deben definir los negocios en los que la compa&#xF1;&#xED;a competir&#xE1; en el futuro. De esta forma, se podr&#xE1;n enfocar los recursos para alcanzar una ventaja competitiva.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
  </objectbank>
