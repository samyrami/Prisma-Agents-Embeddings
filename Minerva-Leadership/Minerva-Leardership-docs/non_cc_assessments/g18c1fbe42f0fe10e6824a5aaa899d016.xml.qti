      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;¿Qué tan útil consideras la experiencia de calificación entre pares de este período? ¿Encontraste valor en evaluar el trabajo de tus compañeros y en recibir retroalimentación del tuyo?&lt;/p&gt;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="6618">
              <material>
                <mattext texttype="text/plain">5</mattext>
              </material>
            </response_label>
            <response_label ident="6376">
              <material>
                <mattext texttype="text/plain">4</mattext>
              </material>
            </response_label>
            <response_label ident="5663">
              <material>
                <mattext texttype="text/plain">3</mattext>
              </material>
            </response_label>
            <response_label ident="628">
              <material>
                <mattext texttype="text/plain">2</mattext>
              </material>
            </response_label>
            <response_label ident="7654">
              <material>
                <mattext texttype="text/plain">1</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">6618</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
    </item>
