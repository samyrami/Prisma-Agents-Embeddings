            <fieldentry>71520,99495,52374,28119</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Las fuentes de las ventajas competitivas:&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="71520">
              <material>
                <mattext texttype="text/html">Son los aspectos o partes de la empresa que más contribuyen a la generación de valor&amp;nbsp;</mattext>
              </material>
            </response_label>
