    <item ident="g0d30bac38d1240146837b50a56694a6f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>42125,43675,9705,27029</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El análisis estratégico se ocupa del diagnóstico…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="42125">
              <material>
                <mattext texttype="text/plain">de los factores externos a la organización.</mattext>
              </material>
            </response_label>
            <response_label ident="43675">
              <material>
                <mattext texttype="text/plain">de los factores internos a la organización.</mattext>
              </material>
            </response_label>
            <response_label ident="9705">
              <material>
                <mattext texttype="text/plain">de los factores internos y externos.</mattext>
              </material>
            </response_label>
            <response_label ident="27029">
              <material>
                <mattext texttype="text/plain">de las tendencias económicas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">9705</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El análisis estratégico incluye el diagnóstico de las oportunidades y amenazas (factores externos) ante las que puede enfrentarse la compañía, y los puntos fuertes y débiles (factores internos) con que cuenta la misma.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g326d5b840ab122c100f7b36ca6e7fa81" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>56346,6976,4243,5050</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El entorno específico de la empresa se centra en el análisis del contexto…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="56346">
              <material>
                <mattext texttype="text/plain">político – legal</mattext>
              </material>
            </response_label>
            <response_label ident="6976">
              <material>
                <mattext texttype="text/plain">sociocultural</mattext>
              </material>
            </response_label>
            <response_label ident="4243">
              <material>
                <mattext texttype="text/plain">demográfico</mattext>
              </material>
            </response_label>
            <response_label ident="5050">
              <material>
                <mattext texttype="text/plain">ninguno de los anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5050</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El entorno específico se refiere a la parte del entorno más cercana a la actividad habitual de la empresa, es decir al sector de actividad económica al que pertenece la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gc3085d324e4a41aa1ec2bb615310120f" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>47439,71958,58973,32350</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La probabilidad de reacción de los competidores existentes ante la entrada de una nueva empresa será mayor si…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="47439">
              <material>
                <mattext texttype="text/plain">existe tradición de este tipo de reacciones</mattext>
              </material>
            </response_label>
            <response_label ident="71958">
              <material>
                <mattext texttype="text/plain">hay poca movilidad de los activos</mattext>
              </material>
            </response_label>
            <response_label ident="58973">
              <material>
                <mattext texttype="text/plain">las compañías existentes tienen recursos suficientes para defenderse</mattext>
              </material>
            </response_label>
            <response_label ident="32350">
              <material>
                <mattext texttype="text/plain">todas las anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">32350</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">&amp;nbsp;Entre las condiciones que señalan una alta probabilidad de reacción por parte de los competidores existentes ante la entrada de una nueva empresa, destacan las tres citadas, junto con la existencia de un sector con un ritmo de crecimiento lento.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g633129536a8b99c8b3430abc64432180" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>51508,16692,64937</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La dimensión sociocultural…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="51508">
              <material>
                <mattext texttype="text/plain">Debe ser analizada dentro del entorno específico de la empresa, ya que influye directamente en el sector en el que actúa la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="16692">
              <material>
                <mattext texttype="text/plain">Debe ser analizada dentro del entorno general</mattext>
              </material>
            </response_label>
            <response_label ident="64937">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">16692</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">&amp;nbsp;La dimensión sociocultural es una de las dimensiones del entorno general, ya que tiene impacto en todas las industrias.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g763d0ee18b7e9884a0bbbfb61ccc773c" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>61132,37211,53506,82747</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El entorno específico está relacionado con&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="61132">
              <material>
                <mattext texttype="text/plain">Los factores externos a la empresa directamente ligados al sector o industria donde compite</mattext>
              </material>
            </response_label>
            <response_label ident="37211">
              <material>
                <mattext texttype="text/html">Los factores internos a la empresa directamente ligados al sector o industria donde compite&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="53506">
              <material>
                <mattext texttype="text/plain">Los factores internos a la empresa directamente ligados a todo el entorno económico, a todos los mercados y sectores</mattext>
              </material>
            </response_label>
            <response_label ident="82747">
              <material>
                <mattext texttype="text/plain">Los factores externos a la empresa directamente ligados a todo el entorno económico, a todos los mercados y sectores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">61132</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El entorno específico está relacionado con los factores y actores externos que influyen en la estrategia de la empresa según el tipo de actividad que desarrolla.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g9ec6ac2778aaa292fdc1dd735a6ff2f1" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>89783,28142,11225,89219</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Una industria estratégica se corresponde siempre&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="89783">
              <material>
                <mattext texttype="text/plain">Con una industria emergente intensiva en tecnología</mattext>
              </material>
            </response_label>
            <response_label ident="28142">
              <material>
                <mattext texttype="text/plain">Con una industria emergente intensiva en mano de obra</mattext>
              </material>
            </response_label>
            <response_label ident="11225">
              <material>
                <mattext texttype="text/html">Con una industria intensiva en tecnología, pero no necesariamente una industria emergente&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="89219">
              <material>
                <mattext texttype="text/plain">Con una industria intensiva en mano de obra, pero no necesariamente una industria emergente</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">11225</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Una industria estratégica es aquella que utiliza tecnologías sofisticadas, intensivas en capital y gran proyección de futuro, pero no necesariamente se corresponde con una industria nueva o emergente, ya que puede llevar bastantes años establecida.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g06e5f83e021e768cebfce57016ecaab1" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>80059,75001,92481,8083</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La segmentación de mercados puede hacerse desde el punto de vista de la demanda y desde el punto de vista de la oferta.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="80059">
              <material>
                <mattext texttype="text/plain">Sólo desde el punto de vista de la demanda</mattext>
              </material>
            </response_label>
            <response_label ident="75001">
              <material>
                <mattext texttype="text/plain">Sólo desde el punto de vista de la oferta</mattext>
              </material>
            </response_label>
            <response_label ident="92481">
              <material>
                <mattext texttype="text/plain">Desde el punto de vista de la demanda y desde el punto de vista de la oferta</mattext>
              </material>
            </response_label>
            <response_label ident="8083">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">92481</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">La segmentación del mercado puede hacerse desde el punto de vista de la demanda (segmentación de clientes) o desde el punto de vista de la oferta (identificar las posiciones de mercado de las empresas rivales).</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g55e494397940fbf7cfbb62d3e8a63dc7" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>19178,33488,34048,61564</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Un grupo estratégico es un grupo de empresas, dentro de una industria, que siguen estrategias similares.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="19178">
              <material>
                <mattext texttype="text/plain">Que siguen estrategias similares a lo largo de las dimensiones estratégicas, pero no la misma estrategia</mattext>
              </material>
            </response_label>
            <response_label ident="33488">
              <material>
                <mattext texttype="text/html">Que siguen la misma estrategia o estrategias similares a lo largo de las dimensiones estratégicas&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="34048">
              <material>
                <mattext texttype="text/plain">Que siguen exactamente la misma estrategia</mattext>
              </material>
            </response_label>
            <response_label ident="61564">
              <material>
                <mattext texttype="text/plain">Ninguna es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">33488</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">De acuerdo con Porter, un grupo estratégico se puede definir como “el conjunto de empresas en un sector industrial que siguen o bien una misma estrategia o bien una similar a lo largo de las dimensiones estratégicas”.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb63f4ec22af4c9b8894c84f81b221104" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
