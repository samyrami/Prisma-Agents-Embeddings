    <item ident="gef66552b12bcc76a6350180e18fb7d92" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>35581,24029,69364</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Desde una perspectiva organizacional, ¿Qué poderes están más vinculados al liderazgo?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="35581">
              <material>
                <mattext texttype="text/plain">El poder experto y el poder referente.</mattext>
              </material>
            </response_label>
            <response_label ident="24029">
              <material>
                <mattext texttype="text/html">El poder coercitivo y el poder legítimo.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="69364">
              <material>
                <mattext texttype="text/html">&amp;nbsp;El poder coercitivo y el poder de recompensa.&amp;nbsp;</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">35581</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El liderazgo queda más vinculado al poder experto y al poder referente mientras que un gestor que no lidera tendrá cierta tendencia a abusar del poder de recompensa, del poder coercitivo y del poder legítimo.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
