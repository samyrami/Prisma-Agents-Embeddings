          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Respecto a los tipos de poder, ¿Cuál se basa en la vida personal para relacionarse y en el poder personal de atracción?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="80138">
              <material>
                <mattext texttype="text/plain">Poder experto.</mattext>
              </material>
            </response_label>
            <response_label ident="42394">
              <material>
                <mattext texttype="text/html">Poder legítimo.&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="85274">
              <material>
                <mattext texttype="text/plain">Poder referente.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">85274</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Poder referente: se basa en la vida personal para relacionarse y en el poder personal de atracción. Los líderes que atraen a los demás por su estilo con su carisma poseen poder referente.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
