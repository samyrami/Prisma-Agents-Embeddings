    <item ident="ge53fc7ae4148f0c39d4b0f83b6c4bfb0" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>43908,52504,44564</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;¿Cuándo favorece la estrategia de enfoque la existencia de un nicho de mercado?&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="43908">
              <material>
                <mattext texttype="text/plain">Cuando es manejable (nicho de mercado pequeño)</mattext>
              </material>
            </response_label>
            <response_label ident="52504">
              <material>
                <mattext texttype="text/plain">Cuando es suficientemente grande</mattext>
              </material>
            </response_label>
            <response_label ident="44564">
              <material>
                <mattext texttype="text/plain">Si hay un nicho identificable, siempre es interesante una estrategia de enfoque. El tamaño del nicho no favorece o dificulta la posibilidad de desarrollar una estrategia de enfoque</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">52504</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">El nicho de mercado debe ser lo suficientemente grande como para que sea rentable. Por tanto, el tamaño del nicho influye, y será más fácil desarrollar la estrategia de enfoque si el nicho es grande.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
