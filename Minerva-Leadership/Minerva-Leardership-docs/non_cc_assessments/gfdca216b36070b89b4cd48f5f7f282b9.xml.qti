    <item ident="g7cfa3100fcf1ffe0c0db48454af2550a" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>60089,74535,22617</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;Una estrategia de enfoque&amp;nbsp;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="60089">
              <material>
                <mattext texttype="text/html">Es atractiva cuando existe potencial de crecimiento&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="74535">
              <material>
                <mattext texttype="text/html">No es atractiva cuando existe potencial de crecimiento&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="22617">
              <material>
                <mattext texttype="text/plain">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">60089</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">Uno de los motivos que puede justificar el desarrollo de una estrategia de enfoque es la existencia de un alto potencial de crecimiento en dicho segmento.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g4855b3abb6722e2fc6cf6e55df054122" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
