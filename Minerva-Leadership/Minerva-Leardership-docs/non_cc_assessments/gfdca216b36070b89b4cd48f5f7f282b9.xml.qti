        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">30385</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">A través de esta estrategia, la empresa intenta aprovechar la tecnología y las capacidades existentes o nuevas para introducir sus productos en mercados diferentes.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gbf9cb8fd23125c694b9cf417f35623da" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>27781,59969,92617</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La estrategia debe estar basada en una ventaja competitiva sostenible en el largo plazo y que no pueda ser atacada por los competidores.&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="27781">
              <material>
                <mattext texttype="text/plain">Por tanto, la ventaja competitiva no debe poder ser atacada por los competidores</mattext>
              </material>
            </response_label>
            <response_label ident="59969">
              <material>
                <mattext texttype="text/plain">Por muy fuerte que sea, la ventaja será atacada por la competencia antes o después. La estrategia será mejor cuanto más tarde ataque la competencia.</mattext>
              </material>
            </response_label>
            <response_label ident="92617">
              <material>
                <mattext texttype="text/plain">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">59969</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">En el largo plazo ninguna ventaja competitiva se puede considerar como inatacable. Cuanto mayor sea el plazo que esa ventaja competitiva sea sostenible ante las acciones de la competencia, mayor posibilidad de éxito tendrá la estrategia.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="g5ca397a493ca30b68be6ff678e280607" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry>1.0</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>38353,41459,55909,79257</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;En las estrategias de liderazgo en costes,&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="38353">
              <material>
                <mattext texttype="text/plain">La empresa ofrece un producto o un servicio diferenciado con un coste alto</mattext>
              </material>
            </response_label>
            <response_label ident="41459">
              <material>
                <mattext texttype="text/plain">La empresa ofrece un producto o un servicio diferenciado con un coste bajo</mattext>
              </material>
            </response_label>
            <response_label ident="55909">
              <material>
                <mattext texttype="text/plain">La empresa ofrece un producto o un servicio similar al de los competidores con un coste alto</mattext>
              </material>
            </response_label>
            <response_label ident="79257">
              <material>
                <mattext texttype="text/plain">La empresa ofrece un producto o un servicio similar al de los competidores con un coste bajo</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="Yes">
          <conditionvar>
            <other/>
          </conditionvar>
          <displayfeedback feedbacktype="Response" linkrefid="general_fb"/>
        </respcondition>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">79257</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/plain">En la estrategia de liderazgo de costes pura la empresa ofrece un producto similar al de los competidores pero a un precio inferior. Cuando el producto es diferenciado o considerado único por el cliente se trataría de una estrategia de diferenciación.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="gb9ec10d5863ca01e5d820e0a3de58e00" title="Question">
