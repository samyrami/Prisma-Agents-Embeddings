          <mattext texttype="text/html">&lt;div&gt;A través de una estrategia de desarrollo de mercado…&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="68559">
              <material>
                <mattext texttype="text/plain">La empresa introduce nuevos productos en los mercados actuales</mattext>
              </material>
            </response_label>
            <response_label ident="30385">
              <material>
                <mattext texttype="text/plain">La empresa introduce sus productos actuales en nuevos mercados</mattext>
              </material>
            </response_label>
            <response_label ident="8426">
              <material>
                <mattext texttype="text/plain">La empresa introduce nuevos productos en nuevos mercados</mattext>
              </material>
            </response_label>
            <response_label ident="65722">
              <material>
                <mattext texttype="text/plain">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
