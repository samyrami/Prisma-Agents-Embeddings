            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>f7682908-95fe-42fd-b736-50c6c6bd89b7,0ea40a70-8528-4350-a992-ac0cc50ed46c,9a873210-26d0-41e8-9483-cff1bfddc65f,9b062c71-ab16-4fab-a009-5244e6921ddc</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>3a7a78fab2db1b895cfe0acf4a6130ea</fieldentry>
          </qtimetadatafield>
