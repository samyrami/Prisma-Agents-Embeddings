            </response_label>
            <response_label ident="f5f38b5d-34a0-409e-85fe-fb049507a5c1">
              <material>
                <mattext texttype="text/html">Influye en el volumen de producci&#xF3;n</mattext>
              </material>
            </response_label>
            <response_label ident="91234ff5-0ab9-4036-95b4-b05a99a26fd8">
              <material>
                <mattext texttype="text/html">Impacta en el servicio al cliente por cumplimiento de los pedidos&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="ca87b1b6-7ba7-45b8-973f-912e1a1d7072">
              <material>
                <mattext texttype="text/html">Todas las opciones son correctas</mattext>
              </material>
