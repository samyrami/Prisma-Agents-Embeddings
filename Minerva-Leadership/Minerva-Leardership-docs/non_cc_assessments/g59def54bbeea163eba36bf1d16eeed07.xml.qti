    <item ident="6678587d022010b3b2e98aa755504984" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>d86d7651-9761-4edb-bb9d-e38227380cab,ce320cd6-1e73-48b5-8d34-4c30b90246fb,4add0ccd-3927-4cf2-b46f-4ad56532ef00,5976337a-4965-4d16-8fd4-c99301ad36eb</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>dcb92c8b6b3035131408dc37f1bad3dd</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La probabilidad de reacci&#xF3;n de los competidores existentes ante la entrada de una nueva empresa ser&#xE1; mayor si&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="d86d7651-9761-4edb-bb9d-e38227380cab">
              <material>
                <mattext texttype="text/html">existe tradici&#xF3;n de este tipo de reacciones</mattext>
              </material>
            </response_label>
            <response_label ident="ce320cd6-1e73-48b5-8d34-4c30b90246fb">
              <material>
                <mattext texttype="text/html">hay poca movilidad de los activos</mattext>
              </material>
            </response_label>
            <response_label ident="4add0ccd-3927-4cf2-b46f-4ad56532ef00">
              <material>
                <mattext texttype="text/html">las compa&#xF1;&#xED;as existentes tienen recursos suficientes para defenderse</mattext>
              </material>
            </response_label>
            <response_label ident="5976337a-4965-4d16-8fd4-c99301ad36eb">
              <material>
                <mattext texttype="text/html">todas las anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">5976337a-4965-4d16-8fd4-c99301ad36eb</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">&amp;nbsp;Entre las condiciones que se&#xF1;alan una alta probabilidad de reacci&#xF3;n por parte de los competidores existentes ante la entrada de una nueva empresa, destacan las tres citadas, junto con la existencia de un sector con un ritmo de crecimiento lento.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="10a81ef3f6c0ac5c8f13b535dc7766c6" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
