            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>11f3d30f-480d-4e92-bd5c-a3a22b110891,f2116fda-3c20-42fb-8053-3930255f0a11,b1f3d7b4-1c94-42b7-aebd-455ed1758f3b,b9a51836-4923-4170-b629-9e7b1f5ad9d4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>1b12f89729ec9a133d8e8722e5be7ba5</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;La cadena de valor&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="11f3d30f-480d-4e92-bd5c-a3a22b110891">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para vender un producto, pero no se aplica para las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="f2116fda-3c20-42fb-8053-3930255f0a11">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para fabricar un producto, pero no se aplica para las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="b1f3d7b4-1c94-42b7-aebd-455ed1758f3b">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para vender un producto, y puede aplicarse a las empresas de servicio</mattext>
              </material>
            </response_label>
            <response_label ident="b9a51836-4923-4170-b629-9e7b1f5ad9d4">
              <material>
                <mattext texttype="text/html">Desagrega las actividades b&#xE1;sicas que se deben llevar a cabo para fabricar un producto, y puede aplicarse a las empresas de servicio</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">b1f3d7b4-1c94-42b7-aebd-455ed1758f3b</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">La cadena de valor desagrega todas las actividades b&#xE1;sicas necesarias para la venta de un producto o un servicio. Es decir, no se queda &#xFA;nicamente en la fabricaci&#xF3;n, y es de aplicaci&#xF3;n tambi&#xE9;n para las empresas de servicio.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="620fb473815ff8387292c424b76ba6b5" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
