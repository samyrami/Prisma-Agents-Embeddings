          <render_choice>
            <response_label ident="c1d5e4de-31f8-4691-ad77-d98379ee6a7f">
              <material>
                <mattext texttype="text/html">Son los aspectos o partes de la empresa que m&#xE1;s contribuyen a la generaci&#xF3;n de valor&amp;nbsp;</mattext>
              </material>
            </response_label>
            <response_label ident="e5b5b743-a244-4e19-a1f4-0e4592b34444">
              <material>
                <mattext texttype="text/html">Son los aspectos o partes de la empresa que menos contribuyen a la generaci&#xF3;n de valor</mattext>
              </material>
            </response_label>
            <response_label ident="cde40187-5f78-4cfb-ab30-8e1e15a0799c">
              <material>
                <mattext texttype="text/html">No contribuyen necesariamente a la generaci&#xF3;n de valor</mattext>
              </material>
            </response_label>
            <response_label ident="364c8137-39e5-425c-bb00-4f7a8fefc8e7">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
