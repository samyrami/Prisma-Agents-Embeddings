          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las ventajas competitivas son precisamente los aspectos o partes de la empresa que m&#xE1;s contribuyen a la generaci&#xF3;n de valor.</mattext>
          </material>
