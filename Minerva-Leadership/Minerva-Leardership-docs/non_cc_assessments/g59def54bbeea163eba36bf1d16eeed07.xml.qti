        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="50e526a4-173a-4dba-99e5-e1bc0188707e">
              <material>
                <mattext texttype="text/html">Los factores externos a la empresa directamente ligados al sector o industria donde compite</mattext>
