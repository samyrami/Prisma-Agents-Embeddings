      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El an&#xE1;lisis funcional&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="0ca45476-837e-4154-aa34-4438d414d1bf">
              <material>
                <mattext texttype="text/html">Puede utilizar diferentes &#xE1;reas funcionales seg&#xFA;n la empresa</mattext>
              </material>
            </response_label>
            <response_label ident="2d768beb-dd80-42f0-ac8b-418ec2f7e26d">
              <material>
                <mattext texttype="text/html">Utiliza las mismas &#xE1;reas funcionales en todas las empresas</mattext>
              </material>
            </response_label>
            <response_label ident="fbd66d1a-cf8b-4ebd-b80b-ed13a125a70a">
              <material>
                <mattext texttype="text/html">No est&#xE1; influido en la elecci&#xF3;n de las &#xE1;reas funcionales que utiliza por las formas de competencia en el sector</mattext>
              </material>
            </response_label>
            <response_label ident="70ab09a9-9e51-405e-8780-6742eff081a8">
              <material>
                <mattext texttype="text/html">Ninguna de las otras opciones es correcta</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">0ca45476-837e-4154-aa34-4438d414d1bf</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">Las &#xE1;reas funcionales que consideremos depender&#xE1;n de cada empresa, ya que cada uno de los aspectos que analicemos podr&#xE1; tener una importancia diferente seg&#xFA;n el tipo de empresa analizado o el sector donde est&#xE1; compita, e incluso en la forma de competencia dentro del sector.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="5ae9ad95eaf94dc88b7b80ca0e1ee3a4" title="Question">
