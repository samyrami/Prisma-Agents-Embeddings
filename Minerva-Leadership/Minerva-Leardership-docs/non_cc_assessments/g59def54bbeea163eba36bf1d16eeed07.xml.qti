            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El entorno espec&#xED;fico de la empresa se centra en el an&#xE1;lisis del contexto&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ed02e83a-4d3b-45f1-95c1-c20d5d035971">
              <material>
                <mattext texttype="text/html">pol&#xED;tico &#x2013; legal</mattext>
              </material>
            </response_label>
            <response_label ident="7e5f5e78-ec10-4e79-9940-2c3f42bad5dd">
              <material>
                <mattext texttype="text/html">sociocultural</mattext>
              </material>
            </response_label>
            <response_label ident="8d435a3d-27e0-41ac-80f8-972037c24761">
              <material>
                <mattext texttype="text/html">demogr&#xE1;fico</mattext>
              </material>
            </response_label>
            <response_label ident="c30007af-3fd6-4409-a1f8-6f1c55276d9e">
              <material>
                <mattext texttype="text/html">ninguno de los anteriores</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">c30007af-3fd6-4409-a1f8-6f1c55276d9e</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El entorno espec&#xED;fico se refiere a la parte del entorno m&#xE1;s cercana a la actividad habitual de la empresa, es decir al sector de actividad econ&#xF3;mica al que pertenece la empresa.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
    <item ident="453fc0534075a6d7f0831e5941d20306" title="Question">
      <itemmetadata>
        <qtimetadata>
          <qtimetadatafield>
            <fieldlabel>question_type</fieldlabel>
            <fieldentry>multiple_choice_question</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>points_possible</fieldlabel>
            <fieldentry/>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>original_answer_ids</fieldlabel>
            <fieldentry>ffaff78b-95aa-4787-a75d-225fdd677825,109cea8e-0fd9-4501-9525-ea8f904aa710,7d74abab-4b3d-482a-9504-2aeab3aad665,51fdfb0a-340c-4c57-b4dd-94944546f808</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>assessment_question_identifierref</fieldlabel>
            <fieldentry>d260646e1b488cbc9b3bfd37c8faa9e4</fieldentry>
          </qtimetadatafield>
          <qtimetadatafield>
            <fieldlabel>calculator_type</fieldlabel>
            <fieldentry>none</fieldentry>
          </qtimetadatafield>
        </qtimetadata>
      </itemmetadata>
      <presentation>
        <material>
          <mattext texttype="text/html">&lt;div&gt;El an&#xE1;lisis estrat&#xE9;gico se ocupa del diagn&#xF3;stico&#x2026;&lt;/div&gt;</mattext>
        </material>
        <response_lid ident="response1" rcardinality="Single">
          <render_choice>
            <response_label ident="ffaff78b-95aa-4787-a75d-225fdd677825">
              <material>
                <mattext texttype="text/html">de los factores externos a la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="109cea8e-0fd9-4501-9525-ea8f904aa710">
              <material>
                <mattext texttype="text/html">de los factores internos a la organizaci&#xF3;n.</mattext>
              </material>
            </response_label>
            <response_label ident="7d74abab-4b3d-482a-9504-2aeab3aad665">
              <material>
                <mattext texttype="text/html">de los factores internos y externos.</mattext>
              </material>
            </response_label>
            <response_label ident="51fdfb0a-340c-4c57-b4dd-94944546f808">
              <material>
                <mattext texttype="text/html">de las tendencias econ&#xF3;micas.</mattext>
              </material>
            </response_label>
          </render_choice>
        </response_lid>
      </presentation>
      <resprocessing>
        <outcomes>
          <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
        </outcomes>
        <respcondition continue="No">
          <conditionvar>
            <varequal respident="response1">7d74abab-4b3d-482a-9504-2aeab3aad665</varequal>
          </conditionvar>
          <setvar action="Set" varname="SCORE">100</setvar>
        </respcondition>
      </resprocessing>
      <itemfeedback ident="general_fb">
        <flow_mat>
          <material>
            <mattext texttype="text/html">El an&#xE1;lisis estrat&#xE9;gico incluye el diagn&#xF3;stico de las oportunidades y amenazas (factores externos) ante las que puede enfrentarse la compa&#xF1;&#xED;a, y los puntos fuertes y d&#xE9;biles (factores internos) con que cuenta la misma.</mattext>
          </material>
        </flow_mat>
      </itemfeedback>
    </item>
  </objectbank>
